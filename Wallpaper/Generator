# image_generator.py
import numpy as np
from PIL import Image # Corrected import
import os
import logging
import time

# Configure basic logging (can be configured further in main.py if needed)
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

# --- Configuration ---
# Define a reasonable limit to prevent excessive memory allocation
# Example: Limit to ~256 MB for the raw pixel data (adjust as needed)
# Calculation: width * height * 3 (bytes for RGB) < MAX_BYTES
MAX_BYTES = 256 * 1024 * 1024 # 256 MiB
# Or define by max pixels (e.g., 8K resolution equivalent)
# MAX_PIXELS = 7680 * 4320
MAX_PIXELS = MAX_BYTES // 3 # Calculate max pixels based on byte limit for RGB
# --- End Configuration ---


def generate_random_image(width: int, height: int, save_path: str) -> str | None:
    """
    Generates an image with random pixel colors using NumPy for performance
    and saves it using Pillow.

    Args:
        width: The width of the image in pixels (must be > 0).
        height: The height of the image in pixels (must be > 0).
        save_path: The full path (including filename) where the image should be saved.
                   The format is determined by the file extension (e.g., .png, .jpg).

    Returns:
        The absolute path where the image was saved if successful, otherwise None.

    Raises:
        ValueError: If width, height are not positive integers, save_path is invalid,
                    or the requested dimensions exceed the configured limit (MAX_PIXELS).
        OSError: If file system errors occur (permissions, disk full, etc.).

    Requires:
        - Pillow (pip install Pillow)
        - NumPy (pip install numpy)
    """
    # --- Input Validation ---
    if not isinstance(width, int) or width <= 0:
        msg = f"Invalid width provided: {width}. Must be a positive integer."
        logging.error(msg)
        raise ValueError(msg)
    if not isinstance(height, int) or height <= 0:
        msg = f"Invalid height provided: {height}. Must be a positive integer."
        logging.error(msg)
        raise ValueError(msg)
    if not isinstance(save_path, str) or not save_path.strip():
        msg = "Invalid save_path provided. Must be a non-empty string."
        logging.error(msg)
        raise ValueError(msg)

    # --- Resource Limit Check ---
    num_pixels = width * height
    if num_pixels > MAX_PIXELS:
        msg = (f"Requested image dimensions ({width}x{height} = {num_pixels} pixels) "
               f"exceed the configured limit of {MAX_PIXELS} pixels. "
               f"Aborting to prevent excessive memory usage.")
        logging.error(msg)
        raise ValueError(msg)

    abs_save_path = os.path.abspath(save_path)
    output_dir = os.path.dirname(abs_save_path)

    logging.info(f"Attempting to generate a {width}x{height} random RGB image ({num_pixels} pixels).")
    start_time = time.time()

    try:
        # --- Directory Creation & Permissions Check ---
        if output_dir:
            os.makedirs(output_dir, exist_ok=True)
            if not os.access(output_dir, os.W_OK):
                msg = f"Output directory '{output_dir}' is not writable."
                logging.error(msg)
                raise OSError(msg) # Raise OSError for permission issues
        elif not os.access('.', os.W_OK): # Check current dir if no specific dir given
            msg = "Current directory '.' is not writable."
            logging.error(msg)
            raise OSError(msg) # Raise OSError for permission issues

        # --- Image Data Generation (using NumPy) ---
        logging.debug(f"Allocating NumPy array for {height}x{width}x3...")
        # Use np.uint8 for 0-255 range directly
        random_data: np.ndarray = np.random.randint(0, 256, size=(height, width, 3), dtype=np.uint8)
        generation_time = time.time() - start_time
        logging.debug(f"NumPy array generated in {generation_time:.4f} seconds.")

        # --- Image Creation (from NumPy data) ---
        img = Image.fromarray(random_data, 'RGB')
        logging.debug("Pillow Image object created from NumPy array.")

        # --- Image Saving ---
        logging.info(f"Saving image to: {abs_save_path}")
        # Pillow's save handles format based on extension and raises errors
        # (like IOError, OSError, ValueError for unsupported formats) on failure.
        img.save(abs_save_path)
        end_time = time.time()

        logging.info(f"Image successfully generated and saved in {end_time - start_time:.4f} seconds.")
        return abs_save_path

    # --- Specific Error Handling ---
    except MemoryError:
        # Should be less likely now due to MAX_PIXELS check, but still possible
        logging.error(f"Memory Error: Not enough memory to create or process the {width}x{height} image.", exc_info=True)
        return None # Return None for memory errors specifically if you don't want main to crash
    except (IOError, OSError) as e:
        # Catch errors related to file system operations (makedirs, save, permissions, disk full)
        logging.error(f"File system error for path '{abs_save_path}': {e}", exc_info=True)
        # Re-raise OSError so the caller (main.py) knows a file system problem occurred
        raise OSError(f"File system error for path '{abs_save_path}': {e}") from e
    except ValueError as e:
         # Catch potential Pillow internal ValueErrors (e.g., unknown file extension)
         # Also catches our own validation errors if they weren't caught earlier (shouldn't happen)
         logging.error(f"Value error during image processing or saving: {e}", exc_info=True)
         # Re-raise ValueError
         raise ValueError(f"Value error during image processing or saving: {e}") from e
    except Exception as e:
        # Catch any other unexpected errors during generation/saving
        logging.error(f"An unexpected error occurred during image generation/saving: {e}", exc_info=True)
        # It might be better to raise a generic exception here too, so the caller knows *something* failed
        raise RuntimeError(f"An unexpected error occurred: {e}") from e


