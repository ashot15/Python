def run_wallpaper_update():
    """Generates the image and sets it as wallpaper."""
    logger.info("--- Starting Random Wallpaper Generator ---")

    generated_path = None
    try:
        # 1. Generate the random image
        generated_path = generate_random_image(IMAGE_WIDTH, IMAGE_HEIGHT, IMAGE_SAVE_PATH)

    except (ValueError, OSError, RuntimeError) as e:
         logger.error(f"Failed during image generation step: {e}", exc_info=False) # Don't need full traceback here usually
         print(f"\nERROR: Image generation failed: {e}. Aborting.")
         return
    except Exception as e:
         logger.error(f"An unexpected error occurred calling generate_random_image: {e}", exc_info=True)
         print(f"\nERROR: Unexpected error during image generation. See log for details. Aborting.")
         return


    if generated_path:
        logger.info(f"Image generation step successful: {generated_path}")
        # 2. Set the generated image as wallpaper
        success = set_wallpaper(generated_path) # set_wallpaper uses its own logging

        if success:
            logger.info("--- Wallpaper update process completed successfully! ---")
            print("\nSuccess! Wallpaper should be updated.")
        else:
            logger.error("--- Wallpaper update process finished, but setting the wallpaper failed. ---")
            print("\nERROR: Failed to set the new wallpaper.")
            print("Please check the log messages above for details.")
            print(f"The generated image is available at: {generated_path}")
    else:
        # This case might occur if generate_random_image returns None without raising an exception (e.g., MemoryError handled internally)
        logger.error("--- Wallpaper update failed because image generation did not return a valid path (returned None). ---")
        print("\nERROR: Image generation failed (returned None). See log. Aborting.")


