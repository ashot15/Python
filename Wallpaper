logger = logging.getLogger('main') # Use a specific logger name


def get_screen_resolution():
    """Tries to detect the main screen resolution."""
    system = platform.system()
    try:
        if system == "Windows" and ctypes:
            user32 = ctypes.windll.user32
            try:
                # SetProcessDPIAware only exists in Windows Vista+
                if hasattr(user32, 'SetProcessDPIAware'):
                     user32.SetProcessDPIAware()
            except Exception as dpi_e:
                 logger.warning(f"Could not set DPI awareness: {dpi_e}")
            width = user32.GetSystemMetrics(0) # SM_CXSCREEN
            height = user32.GetSystemMetrics(1) # SM_CYSCREEN
            if width > 0 and height > 0:
                 logger.info(f"Detected Windows screen resolution: {width}x{height}")
                 return width, height
            else:
                 logger.warning("GetSystemMetrics returned non-positive dimensions.")
                 return None
        elif system == "Darwin": # macOS
             logger.info("Attempting macOS resolution detection via system_profiler...")
             if not shutil.which("system_profiler"):
                  logger.warning("system_profiler command not found. Cannot detect macOS resolution.")
                  return None
             cmd = ['system_profiler', 'SPDisplaysDataType']
             process = subprocess.run(cmd, capture_output=True, text=True, timeout=10, check=False, encoding='utf-8')
             if process.returncode == 0:
                  output = process.stdout
                  for line in output.splitlines():
                       line_stripped = line.strip()
                       if line_stripped.startswith('Resolution:'):
                            parts = line_stripped.split()
                            if len(parts) >= 2 and 'x' in parts[1]:
                                 res = parts[1].split('x')
                                 try:
                                      width, height = int(res[0]), int(res[1])
                                      logger.info(f"Detected macOS screen resolution: {width}x{height}")
                                      return width, height
                                 except ValueError:
                                      logger.warning(f"Could not parse resolution numbers from: {parts[1]}")
                                      continue
                  logger.warning("Could not parse macOS screen resolution from system_profiler output.")
                  return None
             else:
                  logger.error(f"system_profiler command failed. Stderr: {process.stderr}")
                  return None

        elif system == "Linux":
             logger.info("Attempting Linux resolution detection via xrandr...")
             if shutil.which("xrandr"):
                  cmd = ['xrandr']
                  process = subprocess.run(cmd, capture_output=True, text=True, timeout=5, check=False, encoding='utf-8')
                  if process.returncode == 0:
                       output = process.stdout
                       import re
                       current_match = re.search(r'current\s+(\d+)\s+x\s+(\d+)', output)
                       primary_match = re.search(r'(\d+)x(\d+)\s+.*\s+\*\+', output)

                       if current_match:
                            width, height = int(current_match.group(1)), int(current_match.group(2))
                            logger.info(f"Detected Linux screen resolution (current): {width}x{height}")
                            return width, height
                       elif primary_match:
                            width, height = int(primary_match.group(1)), int(primary_match.group(2))
                            logger.info(f"Detected Linux screen resolution (primary *+): {width}x{height}")
                            return width, height
                       else:
                            first_res_match = re.search(r'(\d+)x(\d+)', output)
                            if first_res_match:
                                 width, height = int(first_res_match.group(1)), int(first_res_match.group(2))
                                 logger.warning(f"Could not find current/primary marker, using first found resolution: {width}x{height}")
                                 return width, height

                       logger.warning("Could not parse Linux screen resolution from xrandr output.")
                       return None
                  else:
                       logger.error(f"xrandr command failed. Stderr: {process.stderr}")
                       return None
             else:
                  logger.warning("xrandr command not found. Cannot detect Linux resolution.")
                  return None
        else:
            logger.warning(f"Screen resolution detection not implemented for {system}, using default.")
            return None
    except FileNotFoundError as e:
         logger.error(f"Command for resolution detection not found: {e}. Using default.")
         return None
    except subprocess.TimeoutExpired:
         logger.error("Timeout expired while detecting screen resolution. Using default.")
         return None
    except Exception as e:
        logger.error(f"Error detecting screen resolution: {e}. Using default.", exc_info=True)
        return None

# --- Configuration ---
logger.info("Detecting screen resolution...")
screen_size = get_screen_resolution()

