# Генерация уникального имени файла
def generate_filename(url, extension, prefix=""):
    parsed_url = urlparse(url)
    path = parsed_url.path
    filename = os.path.basename(path)
    if not filename:
        filename = hashlib.md5(url.encode('utf-8')).hexdigest()
    filename = re.sub(r'[^\w\-_\.]', '_', filename)[:100]
    if not filename.endswith(f".{extension}"):
        filename = f"{filename}.{extension}"
    base_filename = filename
    counter = 1
    while os.path.exists(os.path.join(prefix, filename)):
        filename = f"{base_filename.rsplit('.', 1)[0]}_{counter}.{extension}"
        counter += 1
    return f"{prefix}{filename}" if prefix else filename

# Настройка Selenium
def setup_driver():
    chrome_options = Options()
    chrome_options.add_argument("--headless")
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    try:
        service = Service(ChromeDriverManager().install())
        driver = webdriver.Chrome(service=service, options=chrome_options)
        driver.set_page_load_timeout(30)
        return driver
    except Exception as e:
        logging.getLogger('roblox_crawler').error(f"Ошибка при запуске ChromeDriver: {e}")
        return None

# Загрузка страницы через Selenium
def fetch_page(url):
    logger = logging.getLogger('roblox_crawler')
    logger.info(f"Загрузка страницы: {url}", extra={'url': url})
    driver = setup_driver()
    if not driver:
        return None
    try:
        driver.get(url)
        driver.implicitly_wait(10)
        last_height = driver.execute_script("return document.body.scrollHeight")
        max_scroll_attempts = 5
        attempts = 0
        while attempts < max_scroll_attempts:
            driver.execute_script("window.scrollTo(0, document.body.scrollHeight);")
            time.sleep(2)
            new_height = driver.execute_script("return document.body.scrollHeight")
            if new_height == last_height:
                break
            last_height = new_height
            attempts += 1
        page_source = driver.page_source
        logger.info("Страница успешно загружена", extra={'url': url})
        return page_source
    except Exception as e:
        logger.error(f"Ошибка при загрузке страницы через Selenium: {e}", extra={'url': url})
        return None
    finally:
        driver.quit()

# Проверка доступности URL
async def check_url_availability(url, session, retries=3):
    logger = logging.getLogger('roblox_crawler')
    for attempt in range(retries):
        try:
            async with session.head(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10) as response:
                return response.status == 200
        except Exception as e:
            logger.error(f"Попытка {attempt + 1}/{retries} - Ошибка проверки URL {url}: {e}", extra={'url': url})
            if attempt == retries - 1:
                return False
            await asyncio.sleep(1)
    return False

# Асинхронная загрузка ресурса
async def fetch_resource_async(url, session, binary=False, retries=3):
    logger = logging.getLogger('roblox_crawler')
    logger.info(f"Загрузка ресурса: {url}", extra={'url': url})
    for attempt in range(retries):
        try:
            async with session.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10) as response:
                response.raise_for_status()
                if binary:
                    content = await response.read()
                else:
                    content = await response.text()
                logger.info(f"Ресурс успешно загружен: {url}", extra={'url': url})
                return content
        except Exception as e:
            logger.error(f"Попытка {attempt + 1}/{retries} - Ошибка при загрузке ресурса {url}: {e}", extra={'url': url})
            if attempt == retries - 1:
                return None
            await asyncio.sleep(1)

# Получение размеров изображения
async def get_image_dimensions(url, session, binary_data=None):
    logger = logging.getLogger('roblox_crawler')
    try:
        if binary_data:
            img_data = binary_data
        else:
            async with session.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10) as response:
                img_data = await response.read()
        img = Image.open(BytesIO(img_data))
        return img.size
    except Exception as e:
        logger.error(f"Ошибка получения размеров изображения {url}: {e}", extra={'url': url})
        return None

# Получение метаданных медиа
async def get_media_metadata(url, session, media_type="video"):
    logger = logging.getLogger('roblox_crawler')
    try:
        async with session.get(url, headers={'User-Agent': 'Mozilla/5.0'}, timeout=10) as response:
            media_data = await response.read()
        temp_file = f"temp_{media_type}_{hashlib.md5(url.encode()).hexdigest()}.tmp"
        with open(temp_file, "wb") as f:
            f.write(media_data)

        container = av.open(temp_file)
        duration = container.duration / 1_000_000

        resolution = None
        if media_type == "video":
            video_stream = next((stream for stream in container.streams if stream.type == 'video'), None)
            if video_stream:
                resolution = [video_stream.width, video_stream.height]

        container.close()
        os.remove(temp_file)

        return {
            "duration": duration,
            "resolution": resolution if media_type == "video" else None
        }
    except Exception as e:
        logger.error(f"Ошибка получения метаданных {media_type} {url}: {e}", extra={'url': url})
        return None

# Извлечение шрифтов из CSS
async def extract_fonts_from_css(css_content, base_url, session):
    logger = logging.getLogger('roblox_crawler')
    fonts = set()
    font_face_rules = re.findall(r'@font-face\s*{[^}]+}', css_content, re.DOTALL)
    for rule in font_face_rules:
        urls = re.findall(r'url\(([^)]+)\)', rule)
        for url in urls:
            url = url.strip('\'"')
            if url and re.search(r'\.(woff|woff2|ttf|otf|eot)', url):
                font_url = urljoin(base_url, url)
                is_available = await check_url_availability(font_url, session)
                fonts.add((font_url, is_available))
                logger.info(f"Найден шрифт в CSS (@font-face): {font_url}, доступен: {is_available}", extra={'url': base_url})

    import_rules = re.findall(r'@import\s+url\(([^)]+)\)', css_content)
    for import_url in import_rules:
        import_url = import_url.strip('\'"')
        if import_url:
            import_url = urljoin(base_url, import_url)
            css = await fetch_resource_async(import_url, session)
            if css:
                imported_fonts = await extract_fonts_from_css(css, base_url, session)
                fonts.update(imported_fonts)

    return [{"url": url, "is_available": is_available} for url, is_available in fonts]

# Извлечение CSS
async def extract_css(soup, base_url, session):
    logger = logging.getLogger('roblox_crawler')
    inline_css = []
    external_css = []
    all_fonts = set()

    style_tags = soup.find_all('style')
    for i, style in enumerate(style_tags, 1):
        css = style.get_text(strip=True)
        if css:
            inline_css.append(css)
            fonts = await extract_fonts_from_css(css, base_url, session)
            all_fonts.update((font['url'], font['is_available']) for font in fonts)
            filename = f"style_{i}.css"
            with open(f"output/css/inline/{filename}", 'w', encoding='utf-8') as f:
                f.write(css)
        style.decompose()

    elements_with_style = soup.find_all(lambda tag: tag.has_attr('style'))
    for i, element in enumerate(elements_with_style, 1):
        css = element['style'].strip()
        if css:
            inline_css.append(css)
            fonts = await extract_fonts_from_css(css, base_url, session)
            all_fonts.update((font['url'], font['is_available']) for font in fonts)
            filename = f"style_attr_{i}.css"
            with open(f"output/css/inline/{filename}", 'w', encoding='utf-8') as f:
                f.write(css)
        del element['style']

    link_tags = soup.find_all('link', rel='stylesheet')
    for link in link_tags:
        href = link.get('href')
        if href:
            href = urljoin(base_url, href)
            is_available = await check_url_availability(href, session)
            css = await fetch_resource_async(href, session) if is_available else None
            if css:
                external_css.append(css)
                fonts = await extract_fonts_from_css(css, base_url, session)
                all_fonts.update((font['url'], font['is_available']) for font in fonts)
                filename = generate_filename(href, "css")
                with open(f"output/css/external/{filename}", 'w', encoding='utf-8') as f:
                    f.write(css)
            else:
                logger.warning(f"CSS недоступен: {href}", extra={'url': base_url})
        link.decompose()

    link_tags = soup.find_all('link', href=re.compile(r'fonts\.googleapis\.com'))
    for link in link_tags:
        href = link.get('href')
        if href:
            all_fonts.add((href, True))
            logger.info(f"Найден шрифт через Google Fonts: {href}", extra={'url': base_url})

    return {
        'inline': inline_css,
        'external': external_css,
        'fonts': [{"url": url, "is_available": is_available} for url, is_available in all_fonts]
    }

# Извлечение JavaScript
async def extract_js(soup, base_url, session):
    logger = logging.getLogger('roblox_crawler')
    inline_js = []
    external_js = []

    script_tags = soup.find_all('script')
    for i, script in enumerate(script_tags, 1):
        src = script.get('src')
        if src:
            src = urljoin(base_url, src)
            is_available = await check_url_availability(src, session)
            js = await fetch_resource_async(src, session) if is_available else None
            if js:
                external_js.append(js)
                filename = generate_filename(src, "js")
                with open(f"output/js/external/{filename}", 'w', encoding='utf-8') as f:
                    f.write(js)
            else:
                logger.warning(f"JavaScript недоступен: {src}", extra={'url': base_url})
        else:
            js = script.get_text(strip=True)
            if js:
                inline_js.append(js)
                filename = f"script_{i}.js"
                with open(f"output/js/inline/{filename}", 'w', encoding='utf-8') as f:
                    f.write(js)
        script.decompose()

    event_attrs = ['onclick', 'onchange', 'onmouseover', 'onmouseout', 'onload']
    i = 1
    for element in soup.find_all(True):
        for attr in event_attrs:
            if element.has_attr(attr):
                js = element[attr].strip()
                if js:
                    inline_js.append(js)
                    filename = f"event_{attr}_{i}.js"
                    with open(f"output/js/inline/{filename}", 'w', encoding='utf-8') as f:
                        f.write(js)
                    i += 1
                del element[attr]

    return {'inline': inline_js, 'external': external_js}

# Извлечение изображений
async def extract_images(soup, base_url, css_data, session):
    logger = logging.getLogger('roblox_crawler')
    images = set()

    img_tags = soup.find_all('img')
    for img in img_tags:
        src = img.get('src') or img.get('data-src')
        if src:
            src = urljoin(base_url, src)
            is_available = await check_url_availability(src, session)
            dimensions = await get_image_dimensions(src, session) if is_available else None
            images.add((src, is_available, dimensions))

    for css in css_data['inline'] + css_data['external']:
        bg_images = re.findall(r'background-image:\s*url\(([^)]+)\)', css)
        for img_url in bg_images:
            img_url = img_url.strip('\'"')
            if img_url:
                img_url = urljoin(base_url, img_url)
                is_available = await check_url_availability(img_url, session)
                dimensions = await get_image_dimensions(img_url, session) if is_available else None
                images.add((img_url, is_available, dimensions))

    return [{"url": url, "is_available": is_available, "dimensions": dimensions} for url, is_available, dimensions in images]

# Извлечение видео
async def extract_videos(soup, base_url, session):
    logger = logging.getLogger('roblox_crawler')
    videos = set()
    video_tags = soup.find_all('video')
    for video in video_tags:
        src = video.get('src') or video.get('poster')
        if src:
            src = urljoin(base_url, src)
            is_available = await check_url_availability(src, session)
            metadata = await get_media_metadata(src, session, "video") if is_available else None
            videos.add((src, is_available, metadata))
        sources = video.find_all('source')
        for source in sources:
            src = source.get('src')
            if src and source.get('type', '').startswith('video/'):
                src = urljoin(base_url, src)
                is_available = await check_url_availability(src, session)
                metadata = await get_media_metadata(src, session, "video") if is_available else None
                videos.add((src, is_available, metadata))
    return [{"url": url, "is_available": is_available, "metadata": metadata} for url, is_available, metadata in videos]

