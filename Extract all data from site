# Извлечение iframe
async def extract_iframes(soup, base_url, session):
    logger = logging.getLogger('roblox_crawler')
    iframes = []
    iframe_tags = soup.find_all('iframe')
    for iframe in iframe_tags:
        src = iframe.get('src')
        iframe_info = {
            'url': None,
            'id': iframe.get('id', ''),
            'class': iframe.get('class', []),
            'width': iframe.get('width', ''),
            'height': iframe.get('height', ''),
            'title': iframe.get('title', ''),
            'content': None,
            'is_available': False
        }
        if src:
            src = urljoin(base_url, src)
            iframe_info['url'] = src
            iframe_info['is_available'] = await check_url_availability(src, session)
            parsed_base = urlparse(base_url)
            parsed_iframe = urlparse(src)
            if parsed_base.netloc == parsed_iframe.netloc and iframe_info['is_available']:
                content = await fetch_resource_async(src, session)
                if content:
                    iframe_info['content'] = content
                else:
                    driver = setup_driver()
                    if driver:
                        try:
                            driver.get(src)
                            driver.implicitly_wait(5)
                            iframe_info['content'] = driver.page_source
                            logger.info(f"Содержимое iframe загружено через Selenium: {src}", extra={'url': base_url})
                        except Exception as e:
                            logger.error(f"Ошибка загрузки iframe через Selenium: {e}", extra={'url': src})
                        finally:
                            driver.quit()
            iframes.append(iframe_info)
            logger.info(f"Найден iframe: {src}, доступен: {iframe_info['is_available']}", extra={'url': base_url})
    return iframes

# Извлечение favicon
async def extract_favicon(soup, base_url, session, processed_favicons):
    logger = logging.getLogger('roblox_crawler')
    favicon_info = {
        'url': None,
        'type': None,
        'sizes': None,
        'is_available': False,
        'dimensions': None
    }

    link_tags = soup.find_all('link', rel=re.compile(r'icon|apple-touch-icon', re.I))
    for link in link_tags:
        href = link.get('href')
        if href:
            favicon_url = urljoin(base_url, href)
            if favicon_url in processed_favicons:
                continue
            processed_favicons.add(favicon_url)
            favicon_info['url'] = favicon_url
            favicon_info['type'] = link.get('type', '')
            favicon_info['sizes'] = link.get('sizes', '')
            favicon_info['is_available'] = await check_url_availability(favicon_url, session)
            if favicon_info['is_available']:
                favicon_info['dimensions'] = await get_image_dimensions(favicon_url, session)
                content = await fetch_resource_async(favicon_url, session, binary=True)
                if content:
                    filename = generate_filename(favicon_url, "ico", "output/favicon/")
                    with open(filename, 'wb') as f:
                        f.write(content)
            logger.info(f"Найден favicon через <link>: {favicon_url}, доступен: {favicon_info['is_available']}", extra={'url': base_url})
            break

    if not favicon_info['url']:
        default_paths = ['/favicon.ico', '/apple-touch-icon.png']
        for path in default_paths:
            default_favicon = urljoin(base_url, path)
            if default_favicon in processed_favicons:
                continue
            processed_favicons.add(default_favicon)
            content = await fetch_resource_async(default_favicon, session, binary=True)
            if content:
                favicon_info['url'] = default_favicon
                favicon_info['is_available'] = True
                favicon_info['dimensions'] = await get_image_dimensions(default_favicon, session, binary_data=content)
                filename = generate_filename(default_favicon, "ico", "output/favicon/")
                with open(filename, 'wb') as f:
                    f.write(content)
                logger.info(f"Найден favicon по стандартному пути: {default_favicon}", extra={'url': base_url})
                break

    return favicon_info

# Разделение HTML
def split_html(soup):
    meta_tags = soup.find_all('meta')
    meta_html = '\n'.join(str(tag) for tag in meta_tags)

    title_tag = soup.find('title')
    title_html = str(title_tag) if title_tag else ''

    head = soup.find('head')
    head_html = str(head) if head else ''

    body = soup.find('body')
    body_html = str(body) if body else ''

    header = body.find('header') if body else None
    header_html = str(header) if header else ''

    main = body.find('main') if body else None
    main_html = str(main) if main else ''

    footer = body.find('footer') if body else None
    footer_html = str(footer) if footer else ''

    full_html = str(soup.prettify())

    return {
        'meta': meta_html,
        'title': title_html,
        'head': head_html,
        'body': body_html,
        'header': header_html,
        'main': main_html,
        'footer': footer_html,
        'full': full_html
    }

# Генерация логичного имени секции на основе URL
def generate_section_name(url):
    parsed_url = urlparse(url)
    path = parsed_url.path.strip('/').replace('/', '_') or 'index'
    return re.sub(r'[^\w\-]', '_', path)[:50]

# Обработка одной страницы
async def process_page(url, session, visited, processed_favicons):
    logger = logging.getLogger('roblox_crawler')
    if url in visited:
        return []
    visited.add(url)

    logger.info(f"Обработка страницы: {url}", extra={'url': url})
    section = generate_section_name(url)
    create_directories(section)

    page_content = fetch_page(url)
    if not page_content:
        return []

    soup = BeautifulSoup(page_content, 'html.parser')
    base_url = '/'.join(url.split('/')[:3])

    css_data = await extract_css(soup, base_url, session)
    fonts = css_data['fonts']
    js = await extract_js(soup, base_url, session)
    images = await extract_images(soup, base_url, css_data, session)
    videos = await extract_videos(soup, base_url, session)
    audio = await extract_audio(soup, base_url, session)
    iframes = await extract_iframes(soup, base_url, session)
    favicon = await extract_favicon(soup, base_url, session, processed_favicons)
    html_parts = split_html(soup)

    # Сохранение HTML
    for part, content in html_parts.items():
        if part == 'full':
            part_dir = 'main'
        else:
            part_dir = part
        with open(f'output/html/{section}/{part_dir}/{part}.html', 'w', encoding='utf-8') as f:
            f.write(content)

    # Сохранение списков ресурсов
    with open('output/images/image_list.txt', 'a', encoding='utf-8') as f:
        f.write(f"\n\n=== {url} ===\n")
        for img in images:
            f.write(f"URL: {img['url']}, Доступен: {img['is_available']}, Размеры: {img['dimensions']}\n")
    with open('output/fonts/font_list.txt', 'a', encoding='utf-8') as f:
        f.write(f"\n\n=== {url} ===\n")
        for font in fonts:
            f.write(f"URL: {font['url']}, Доступен: {font['is_available']}\n")
    with open('output/videos/video_list.txt', 'a', encoding='utf-8') as f:
        f.write(f"\n\n=== {url} ===\n")
        for video in videos:
            f.write(f"URL: {video['url']}, Доступен: {video['is_available']}, Метаданные: {video['metadata']}\n")
    with open('output/audio/audio_list.txt', 'a', encoding='utf-8') as f:
        f.write(f"\n\n=== {url} ===\n")
        for a in audio:
            f.write(f"URL: {a['url']}, Доступен: {a['is_available']}, Метаданные: {a['metadata']}\n")
    with open(f'output/iframes/iframe_list_{section}.txt', 'w', encoding='utf-8') as f:
        for iframe in iframes:
            f.write(f"URL: {iframe['url']}\nID: {iframe['id']}\nClass: {iframe['class']}\nWidth: {iframe['width']}\nHeight: {iframe['height']}\nTitle: {iframe['title']}\nContent: {iframe['content']}\nДоступен: {iframe['is_available']}\n\n")
    with open(f'output/favicon/favicon_info_{section}.txt', 'w', encoding='utf-8') as f:
        f.write(f"URL: {favicon['url']}\nType: {favicon['type']}\nSizes: {favicon['sizes']}\nДоступен: {favicon['is_available']}\nРазмеры: {favicon['dimensions']}")

    # Вывод результатов
    print(f"\n=== Страница: {url} ===")
    for part_name, part_content in html_parts.items():
        print(f"\n=== HTML ({part_name}) ===")
        print(part_content if part_content.strip() else f"{part_name} отсутствует")

    print("\n=== CSS (встроенные) ===")
    print(css_data['inline'] or "Встроенные стили отсутствуют")

    print("\n=== CSS (внешние) ===")
    print(css_data['external'] or "Внешние стили отсутствуют")

    print("\n=== JavaScript (встроенные) ===")
    print(js['inline'] or "Встроенные скрипты отсутствуют")

    print("\n=== JavaScript (внешние) ===")
    print(js['external'] or "Внешние скрипты отсутствуют")

    print("\n=== Изображения ===")
    print(images or "Изображения отсутствуют")

    print("\n=== Шрифты ===")
    print(fonts or "Шрифты отсутствуют")

    print("\n=== Видео ===")
    print(videos or "Видео отсутствуют")

    print("\n=== Аудио ===")
    print(audio or "Аудио отсутствует")

    print("\n=== Iframes ===")
    print(iframes or "Iframes отсутствуют")

    print("\n=== Favicon ===")
    print(favicon)

    # Поиск новых ссылок
    links = set()
    for a_tag in soup.find_all('a', href=True):
        href = a_tag['href']
        href = urljoin(base_url, href)
        parsed_href = urlparse(href)
        parsed_base = urlparse(base_url)
        if parsed_href.netloc == parsed_base.netloc and href not in visited:
            links.add(href)

    return list(links)

# Основная функция обхода сайта
async def crawl_website(start_url):
    logger = logging.getLogger('roblox_crawler')
    visited = set()
    to_visit = [start_url]
    processed_favicons = set()

    async with aiohttp.ClientSession() as session:
        while to_visit:
            current_batch = to_visit[:5]
            to_visit = to_visit[5:]
            tasks = [process_page(url, session, visited, processed_favicons) for url in current_batch]
            new_links = await asyncio.gather(*tasks)
            for links in new_links:
                to_visit.extend(link for link in links if link not in to_visit and link not in visited)

    print("\n=== Логи ===")
    print("Логи сохранены в 'output/logs/extraction.log'")
    print("\nРезультаты сохранены в папку 'output' с соответствующей структурой.")

# Точка входа
if __name__ == "__main__":
    setup_logging()
    url = "https://paybis.com/ru/crypto-wallet/"
    asyncio.run(crawl_website(url))
