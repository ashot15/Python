class TestCSVMaster(unittest.TestCase):
    def setUp(self):
        with open('test.csv', 'w', encoding='utf-8', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(['name', 'age', 'is_active', 'birth_date', 'tags'])
            writer.writerow(['Alice', '25', 'true', '1990-01-01', '["tag1", "tag2"]'])
            writer.writerow(['Bob', '35', 'false', '1985-05-05', '["tag3"]'])

    def test_csv_reader(self):
        reader = CSVReader('test.csv')
        data = list(reader)
        self.assertEqual(len(data), 2)
        self.assertEqual(data[0]['name'], 'Alice')
        self.assertEqual(data[0]['age'], 25)
        self.assertEqual(data[0]['is_active'], True)
        self.assertIsInstance(data[0]['birth_date'], datetime)
        self.assertListEqual(data[0]['tags'], ['tag1', 'tag2'])

    def test_aggregator(self):
        reader = CSVReader('test.csv')
        agg = Aggregator()
        agg.aggregate(reader, ['age'])
        self.assertEqual(agg.sum('age'), 60)
        self.assertEqual(agg.mean('age'), 30)

    def test_validator(self):
        reader = CSVReader('test.csv')
        schema = {
            'age': {'type': int, 'min': 0, 'max': 120},
            'name': {'type': str, 'regex': r'^[A-Za-z]+$'}
        }
        validator = Validator(schema)
        errors = validator.validate(reader)
        self.assertEqual(len(errors), 0)

    def tearDown(self):
        os.remove('test.csv')


