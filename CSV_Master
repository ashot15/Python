class CSVReader:
    """Класс для чтения CSV-файлов с поддержкой диалектов и автоматическим определением типов данных."""
    def __init__(self, file_path: str, dialect: Optional[Union[str, csv.Dialect]] = None, encoding: str = 'utf-8'):
        self.file_path = file_path
        self.dialect = dialect if dialect else csv.excel
        self.encoding = encoding
        self.headers = None
        self.types = None
        self._initialize()

    def _initialize(self):
        """Инициализация заголовков и типов данных на основе первых строк."""
        with open(self.file_path, 'r', encoding=self.encoding) as file:
            reader = csv.DictReader(file, dialect=self.dialect)
            self.headers = reader.fieldnames
            sample_rows = []
            for i, row in enumerate(reader):
                if i < 10:  # Собираем до 10 строк для анализа типов
                    sample_rows.append(row)
                else:
                    break
            self.types = self._detect_types(sample_rows)
            logging.info(f"Определены типы данных: {self.types}")

    def _detect_types(self, rows: List[Dict[str, str]]) -> Dict[str, callable]:
        types = {}
        for key in self.headers:
            values = [row[key] for row in rows if key in row and row[key]]
            types[key] = self._get_type(values)
        return types

    def _get_type(self, values: List[str]) -> callable:
        for value in values:
            try:
                int(value)
                return int
            except ValueError:
                try:
                    float(value)
                    return float
                except ValueError:
                    if value.lower() in ('true', 'false'):
                        return lambda x: x.lower() == 'true'
                    try:
                        date_parser.parse(value)
                        return lambda x: date_parser.parse(x)
                    except ValueError:
                        try:
                            json.loads(value)
                            return json.loads
                        except json.JSONDecodeError:
                            pass
        return str

    def _cast_row(self, row: Dict[str, str]) -> Dict[str, Any]:
        return {key: self.types[key](row[key]) if row[key] else None for key in self.headers}

    def __iter__(self) -> Iterator[Dict[str, Any]]:
        with open(self.file_path, 'r', encoding=self.encoding) as file:
            reader = csv.DictReader(file, dialect=self.dialect)
            next(reader)  # Пропускаем заголовок
            for row in reader:
                yield self._cast_row(row)


class CSVWriter:
    """Класс для записи данных в CSV-файл с поддержкой диалектов."""
    def __init__(self, file_path: str, headers: List[str], dialect: Optional[Union[str, csv.Dialect]] = None, encoding: str = 'utf-8'):
        self.file_path = file_path
        self.headers = headers
        self.dialect = dialect if dialect else csv.excel
        self.encoding = encoding

    def write(self, data: Iterator[Dict[str, Any]]):
        with open(self.file_path, 'w', encoding=self.encoding, newline='') as file:
            writer = csv.DictWriter(file, fieldnames=self.headers, dialect=self.dialect)
            writer.writeheader()
            writer.writerows(data)
            logging.info(f"Данные записаны в {self.file_path}")


class DatabaseAdapter(ABC):
    """Абстрактный класс для интеграции с базами данных."""
    @abstractmethod
    def connect(self):
        pass

    @abstractmethod
    def insert(self, table: str, data: Iterator[Dict[str, Any]]):
        pass

    @abstractmethod
    def close(self):
        pass


class SQLiteAdapter(DatabaseAdapter):
    """Адаптер для SQLite."""
    def __init__(self, db_path: str):
        self.db_path = db_path
        self.connection = None

    def connect(self):
        self.connection = sqlite3.connect(self.db_path)
        self.connection.execute("PRAGMA foreign_keys = ON;")
        logging.info(f"Подключение к SQLite: {self.db_path}")

    def insert(self, table: str, data: Iterator[Dict[str, Any]]):
        cursor = self.connection.cursor()
        for row in data:
            columns = ', '.join(row.keys())
            placeholders = ', '.join('?' * len(row))
            values = tuple(
                json.dumps(v) if isinstance(v, (list, dict)) else
                v.isoformat() if isinstance(v, datetime) else v
                for v in row.values()
            )
            cursor.execute(f'INSERT INTO {table} ({columns}) VALUES ({placeholders})', values)
        self.connection.commit()
        logging.info(f"Данные вставлены в таблицу {table}")

    def close(self):
        if self.connection:
            self.connection.close()
            logging.info("Соединение с SQLite закрыто")


class PostgreSQLAdapter(DatabaseAdapter):
    """Адаптер для PostgreSQL. Требуется установка psycopg2."""
    def __init__(self, host: str, database: str, user: str, password: str):
        if not psycopg2:
            raise ImportError("psycopg2 is required for PostgreSQL support. Install it with 'pip install psycopg2'.")
        self.host = host
        self.database = database
        self.user = user
        self.password = password
        self.connection = None

    def connect(self):
        self.connection = psycopg2.connect(
            host=self.host, database=self.database, user=self.user, password=self.password
        )
        logging.info(f"Подключение к PostgreSQL: {self.database}")

    def insert(self, table: str, data: Iterator[Dict[str, Any]]):
        cursor = self.connection.cursor()
        for row in data:
            columns = ', '.join(row.keys())
            placeholders = ', '.join('%s' * len(row))
            values = tuple(
                json.dumps(v) if isinstance(v, (list, dict)) else
                v.isoformat() if isinstance(v, datetime) else v
                for v in row.values()
            )
            cursor.execute(f'INSERT INTO {table} ({columns}) VALUES ({placeholders})', values)
        self.connection.commit()
        logging.info(f"Данные вставлены в таблицу {table}")

    def close(self):
        if self.connection:
            self.connection.close()
            logging.info("Соединение с PostgreSQL закрыто")


