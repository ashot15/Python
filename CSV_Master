class Aggregator:
    """Класс для агрегации данных."""
    def __init__(self):
        self.data = defaultdict(list)

    def aggregate(self, data: Iterator[Dict[str, Any]], columns: List[str]):
        for row in data:
            for col in columns:
                if col in row and row[col] is not None:
                    self.data[col].append(row[col])
        logging.info(f"Агрегация выполнена для столбцов: {columns}")

    def sum(self, column: str) -> float:
        return sum(self.data[column])

    def mean(self, column: str) -> float:
        return statistics.mean(self.data[column])

    def min(self, column: str) -> Any:
        return min(self.data[column])

    def max(self, column: str) -> Any:
        return max(self.data[column])

    def count(self, column: str) -> int:
        return len(self.data[column])


class Validator:
    """Класс для валидации данных по заданной схеме."""
    def __init__(self, schema: Dict[str, Dict[str, Any]]):
        self.schema = schema
        self.unique_values = defaultdict(set)

    def validate(self, data: Iterator[Dict[str, Any]]) -> List[str]:
        errors = []
        for i, row in enumerate(data):
            for col, rules in self.schema.items():
                value = row.get(col)
                if 'type' in rules and value is not None and not isinstance(value, rules['type']):
                    errors.append(f"Row {i}: {col} should be {rules['type'].__name__}, got {type(value).__name__}")
                if 'min' in rules and value is not None and value < rules['min']:
                    errors.append(f"Row {i}: {col} should be >= {rules['min']}, got {value}")
                if 'max' in rules and value is not None and value > rules['max']:
                    errors.append(f"Row {i}: {col} should be <= {rules['max']}, got {value}")
                if 'regex' in rules and value is not None and isinstance(value, str):
                    if not re.match(rules['regex'], value):
                        errors.append(f"Row {i}: {col} does not match regex {rules['regex']}")
                if 'unique' in rules and rules['unique'] and value is not None:
                    if value in self.unique_values[col]:
                        errors.append(f"Row {i}: {col} should be unique, duplicate found: {value}")
                    else:
                        self.unique_values[col].add(value)
        logging.info(f"Валидация завершена, найдено ошибок: {len(errors)}")
        return errors


