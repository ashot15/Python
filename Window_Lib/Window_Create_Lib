# --- Макросы LOWORD/HIWORD/LOBYTE/HIBYTE ---
def LOWORD(l): return ctypes.c_ushort(l & 0xffff).value
def HIWORD(l): return ctypes.c_ushort((l >> 16) & 0xffff).value
def LOBYTE(w): return ctypes.c_ubyte(w & 0xff).value
def HIBYTE(w): return ctypes.c_ubyte((w >> 8) & 0xff).value
def GET_X_LPARAM(lp): return ctypes.c_short(LOWORD(lp)).value # Координаты мыши могут быть знаковыми
def GET_Y_LPARAM(lp): return ctypes.c_short(HIWORD(lp)).value # Координаты мыши могут быть знаковыми

