def get_client_rect(hwnd) -> RECT:
    """Получает RECT клиентской области окна."""
    rect = RECT()
    if not GetClientRect(hwnd, ctypes.byref(rect)):
         raise ctypes.WinError(GetLastError())
    return rect

def draw_text(hdc, text, rect, format_flags=(0x00000001 | 0x00000004 | 0x00000020)): # DT_CENTER | DT_VCENTER | DT_SINGLELINE
    """Рисует текст с помощью DrawTextW."""
    if not isinstance(rect, RECT): raise TypeError("rect must be a RECT structure")
    result = DrawTextW(hdc, str(text), -1, ctypes.byref(rect), format_flags)
    if result == 0:
         pass # DrawText часто не устанавливает GetLastError
    return result

def set_text_color(hdc, color_bgr):
    """Устанавливает цвет текста GDI (COLORREF BGR)."""
    return SetTextColor(hdc, color_bgr)

def set_bk_mode(hdc, mode):
    """Устанавливает режим фона GDI (1=TRANSPARENT, 2=OPAQUE)."""
    return SetBkMode(hdc, mode)

