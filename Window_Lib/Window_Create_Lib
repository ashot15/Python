# --- Вспомогательная функция для ошибок ---
def get_last_error_message(error_code=None):
    if error_code is None:
        error_code = GetLastError()
    if error_code == 0:
        return "No error."

    msg_buffer = ctypes.c_wchar_p() # Указатель на буфер будет выделен FormatMessageW

    bytes_written = FormatMessageW(
        FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
        None, # source
        error_code, # message id
        0, # language id (default user language)
        ctypes.byref(msg_buffer), # output buffer
        0, # minimum size
        None # arguments
    )

    if bytes_written == 0 or not msg_buffer.value:
        # Ошибка при получении текста ошибки
        return f"WinAPI Error Code {error_code} (Could not format error message)"
    else:
        message = msg_buffer.value.strip()
        # Освобождаем буфер, выделенный LocalAlloc через FormatMessageW
        kernel32.LocalFree(msg_buffer)
        return f"WinAPI Error Code {error_code}: {message}"

def check_win_error(result, func, args):
    """ Callback for ctypes functions to automatically raise WinError on failure.
        Use with: func.errcheck = check_win_error
        Only works reliably for functions that return 0 or FALSE on failure.
    """
    if not result:
         error_code = GetLastError()
         if error_code != 0:
             raise ctypes.WinError(error_code)
         # else: No error code set, might be a different type of failure?
    return result # Return original result if success or no error code

