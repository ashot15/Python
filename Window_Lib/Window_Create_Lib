# --- Макросы LOWORD / HIWORD --- <<< ДОБАВЛЕНО
def LOWORD(l):
  """ Извлекает младшее 16-битное значение (WORD) из LPARAM/DWORD_PTR. """
  return ctypes.c_ushort(l & 0xffff).value # Возвращает как Python int

def HIWORD(l):
  """ Извлекает старшее 16-битное значение (WORD) из LPARAM/DWORD_PTR. """
  return ctypes.c_ushort((l >> 16) & 0xffff).value # Возвращает как Python int

