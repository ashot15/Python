# --- Глобальные переменные и оконная процедура ---
_pending_windows = {}
_window_classes = {} # Перенесем сюда из класса для простоты доступа

# --- Оконная процедура (WndProc) ---
def _UniversalWndProc(hwnd, msg, wparam, lparam):
    """Универсальная оконная процедура"""
    instance = None
    # Эта часть оптимизирована в предыдущем коде и должна быть корректна
    # <...> (код связывания/разрыва связи через GWLP_USERDATA остался прежним)
    try:
        if msg == WM_NCCREATE:
            try:
                cs = ctypes.cast(lparam, ctypes.POINTER(CREATESTRUCTW)).contents
                instance_ptr_addr = cs.lpCreateParams
                if instance_ptr_addr and instance_ptr_addr in _pending_windows:
                    instance = _pending_windows[instance_ptr_addr]
                    SetWindowLongPtrW(hwnd, GWLP_USERDATA, instance_ptr_addr)
                    instance._hwnd = hwnd
                    del _pending_windows[instance_ptr_addr]
                else: return -1 # Error
            except Exception as e:
                print(f"Exception in WM_NCCREATE link: {e}", file=sys.stderr)
                if 'instance_ptr_addr' in locals() and instance_ptr_addr and instance_ptr_addr in _pending_windows:
                   try: del _pending_windows[instance_ptr_addr]
                   except KeyError: pass
                return -1 # Error

        else:
            instance_ptr_addr = GetWindowLongPtrW(hwnd, GWLP_USERDATA)
            if instance_ptr_addr != 0:
                try: instance = ctypes.cast(instance_ptr_addr, ctypes.py_object).value
                except Exception: instance = None

        # Вызов обработчика экземпляра
        result_from_handler = None
        if instance and hasattr(instance, 'handle_message'):
            try:
                result_from_handler = instance.handle_message(hwnd, msg, wparam, lparam)
                if result_from_handler is not None:
                    return result_from_handler
            except Exception as e:
                print(f"Error in instance message handler (msg {msg}): {e}", file=sys.stderr)
                # traceback.print_exc() # For debugging

        # Вызов стандартного обработчика
        final_result = DefWindowProcW(hwnd, msg, wparam, lparam)

        # Очистка при WM_NCDESTROY
        if msg == WM_NCDESTROY and instance_ptr_addr != 0:
            try:
                # print(f"WM_NCDESTROY: Clearing GWLP_USERDATA for HWND {hwnd}")
                SetWindowLongPtrW(hwnd, GWLP_USERDATA, 0) # Clear the link
                if instance and hasattr(instance, '_clear_hwnd'):
                    instance._clear_hwnd() # Notify instance
            except Exception as e_nc:
                 print(f"Error during WM_NCDESTROY cleanup for HWND {hwnd}: {e_nc}", file=sys.stderr)

        return final_result

    except Exception as e_proc:
        print(f"FATAL ERROR in _UniversalWndProc loop (HWND={hwnd}, MSG={msg}): {e_proc}", file=sys.stderr)
        # traceback.print_exc() # For debugging
        # Try to call DefWindowProc in case of error in our logic
        try: return DefWindowProcW(hwnd, msg, wparam, lparam)
        except Exception: return 0 # Last resort

_WndProcInstance = WNDPROC(_UniversalWndProc)


# --- Базовый класс окна ---
class BaseWindow:
    """
    Базовый класс для создания и управления окном приложения Windows.
    Предоставляет методы для управления окном и колбэки для обработки событий.
    """
    # _window_classes = {} # Moved to global scope

    def __init__(self,
                 title="Application Window",
                 width=CW_USEDEFAULT, height=CW_USEDEFAULT,
                 x=CW_USEDEFAULT, y=CW_USEDEFAULT,
                 parent=None, # Can be HWND or another BaseWindow instance
                 menu=None,
                 style=WS_OVERLAPPEDWINDOW,
                 ex_style=WS_EX_APPWINDOW, # Removed WS_EX_WINDOWEDGE for flatter look
                 class_name="PyWindowClass",
                 class_style=CS_HREDRAW | CS_VREDRAW | CS_DBLCLKS,
                 # background: index (COLOR_*), COLORREF (0x00bbggrr), HBRUSH, or None (no background erase)
                 background=COLOR_WINDOW,
                 icon=IDI_APPLICATION, # int (IDI_*) or str (path to .ico)
                 cursor=IDC_ARROW,   # int (IDC_*) or str (path to .cur)
                 # Callbacks (Добавлены новые)
                 on_create=None, on_paint=None, on_destroy=None, on_close=None,
                 on_size=None, on_move=None,
                 on_setfocus=None, on_killfocus=None,
                 on_keydown=None, on_keyup=None, on_char=None, # Key events
                 on_lbuttondown=None, on_lbuttonup=None, on_lbuttondblclk=None, # Left mouse
                 on_rbuttondown=None, on_rbuttonup=None, on_rbuttondblclk=None, # Right mouse
                 on_mbuttondown=None, on_mbuttonup=None, on_mbuttondblclk=None, # Middle mouse
                 on_mousemove=None, on_mousewheel=None, on_mousehover=None, on_mouseleave=None # Other mouse
                 # ... add more specific callbacks as needed (e.g., for WM_COMMAND)
                 ):
        self._hwnd = None
        self._hinstance = GetModuleHandleW(None)
        if not self._hinstance: raise ctypes.WinError(GetLastError())

        # Сохраняем параметры инициализации
        self.initial_title = title
        self.initial_x = x
        self.initial_y = y
        self.initial_width = width
        self.initial_height = height
        self.initial_style = style
        self.initial_ex_style = ex_style
        self.initial_class_name = class_name
        self.initial_class_style = class_style
        self.initial_background = background
        self.initial_icon = icon
        self.initial_cursor = cursor

        # Parent window
        if isinstance(parent, BaseWindow):
            self.parent_hwnd = parent.hwnd if parent.hwnd else None # HWND родителя
        elif isinstance(parent, int) and parent != 0:
            self.parent_hwnd = parent # HWND передан напрямую
        else:
            self.parent_hwnd = None

        self.menu = menu # HMENU (пока не реализовано создание меню)

        # Сохраняем ресурсы класса, чтобы не регистрировать каждый раз
        self.class_atom = None
        self._hicon = None
        self._hcursor = None
        self._hbrush_background = None # Может быть кистью, созданной нами
        self._is_custom_brush = False # Флаг, что кисть создана нами и требует DeleteObject

        # Колбэки
        self.on_create = on_create; self.on_paint = on_paint; self.on_destroy = on_destroy; self.on_close = on_close;
        self.on_size = on_size; self.on_move = on_move;
        self.on_setfocus = on_setfocus; self.on_killfocus = on_killfocus;
        self.on_keydown = on_keydown; self.on_keyup = on_keyup; self.on_char = on_char;
        self.on_lbuttondown=on_lbuttondown; self.on_lbuttonup=on_lbuttonup; self.on_lbuttondblclk=on_lbuttondblclk;
        self.on_rbuttondown=on_rbuttondown; self.on_rbuttonup=on_rbuttonup; self.on_rbuttondblclk=on_rbuttondblclk;
        self.on_mbuttondown=on_mbuttondown; self.on_mbuttonup=on_mbuttonup; self.on_mbuttondblclk=on_mbuttondblclk;
        self.on_mousemove=on_mousemove; self.on_mousewheel=on_mousewheel; self.on_mousehover=on_mousehover; self.on_mouseleave=on_mouseleave;

        self._self_addr = id(self)
        # Регистрация и создание окна теперь происходит в self.create() / self.run()

    def _load_resource(self, res_id_or_path, res_type):
        """Загружает иконку или курсор из ID, системных ID или файла."""
        hinst = self._hinstance
        flags = LR_DEFAULTSIZE | LR_SHARED
        res_name = None

        if isinstance(res_id_or_path, int):
            res_name = LPCWSTR(res_id_or_path) # Используем MAKEINTRESOURCE
            # Пытаемся загрузить из системных (hinst=None)
            handle = LoadImageW(None, res_name, res_type, 0, 0, flags)
            if handle: return handle
            # Если не нашли, ищем в нашем инстансе
            return LoadImageW(hinst, res_name, res_type, 0, 0, flags)

        elif isinstance(res_id_or_path, str):
            flags |= LR_LOADFROMFILE
            res_name = LPCWSTR(res_id_or_path)
            # TODO: Убедиться, что путь корректный и файл существует
            return LoadImageW(None, res_name, res_type, 0, 0, flags) # hinst должен быть None для LR_LOADFROMFILE

        else:
            print(f"Warning: Invalid resource identifier type: {type(res_id_or_path)}. Cannot load.", file=sys.stderr)
            return None # Не удалось определить ресурс

    def _get_background_brush(self):
        """Создает или получает HBRUSH для фона. Устанавливает self._is_custom_brush."""
        self._is_custom_brush = False # Сбрасываем флаг
        bg_ref = self.initial_background

        if bg_ref is None: # Нет фона (для кастомной отрисовки)
            return None
        elif isinstance(bg_ref, (HBRUSH, wintypes.HANDLE)): # Передали готовую кисть
            return bg_ref
        elif isinstance(bg_ref, int):
             if 0 <= bg_ref <= 24: # Похоже на индекс COLOR_*
                 hbrush = GetSysColorBrush(bg_ref)
                 if hbrush: return hbrush
                 else: # Ошибка получения системной кисти, используем запасной вариант
                      print(f"Warning: Failed to get sys color brush for index {bg_ref}. Using COLOR_WINDOW.", file=sys.stderr)
                      return GetSysColorBrush(COLOR_WINDOW)
             else: # Похоже на COLORREF (0x00bbggrr)
                  try:
                      hbrush = CreateSolidBrush(COLORREF(bg_ref))
                      if hbrush:
                          self._is_custom_brush = True # Эту кисть нужно будет удалить
                          return hbrush
                      else: # Ошибка создания кисти
                           print(f"Warning: Failed to create solid brush for color {bg_ref:#x}. Error: {get_last_error_message()}. Using COLOR_WINDOW.", file=sys.stderr)
                           return GetSysColorBrush(COLOR_WINDOW)
                  except Exception as e: # Ошибка преобразования в COLORREF
                       print(f"Warning: Invalid color value for background {bg_ref}: {e}. Using COLOR_WINDOW.", file=sys.stderr)
                       return GetSysColorBrush(COLOR_WINDOW)
        else: # Неизвестный тип
            print(f"Warning: Invalid background type: {type(bg_ref)}. Using COLOR_WINDOW.", file=sys.stderr)
            return GetSysColorBrush(COLOR_WINDOW)

    def _register_class_if_needed(self):
        """Регистрирует класс окна, если необходимо."""
        global _window_classes
        class_key = (self.initial_class_name, self._hinstance) # Ключ для уникальности

        if class_key in _window_classes:
            class_info = _window_classes[class_key]
            self.class_atom = class_info['atom']
            self._hicon = class_info['hicon']
            self._hcursor = class_info['hcursor']
            self._hbrush_background = class_info['hbrush']
            self._is_custom_brush = class_info['is_custom_brush'] # Восстанавливаем флаг
            # print(f"Reusing registered window class '{self.initial_class_name}'")
            return True

        # Регистрация нового класса
        wc = WNDCLASSEXW()
        wc.cbSize = ctypes.sizeof(WNDCLASSEXW)
        wc.style = self.initial_class_style
        wc.lpfnWndProc = _WndProcInstance
        wc.cbClsExtra = 0
        wc.cbWndExtra = 0
        wc.hInstance = self._hinstance

        # Загрузка ресурсов
        self._hicon = self._load_resource(self.initial_icon, IMAGE_ICON)
        self._hcursor = self._load_resource(self.initial_cursor, IMAGE_CURSOR)
        self._hbrush_background = self._get_background_brush() # Устанавливает _is_custom_brush

        # Установка в структуру (с фоллбэками)
        wc.hIcon = self._hicon if self._hicon else self._load_resource(IDI_APPLICATION, IMAGE_ICON)
        wc.hCursor = self._hcursor if self._hcursor else self._load_resource(IDC_ARROW, IMAGE_CURSOR)
        wc.hbrBackground = self._hbrush_background # Может быть None
        wc.lpszMenuName = None
        wc.lpszClassName = LPCWSTR(self.initial_class_name)
        wc.hIconSm = self._hicon # Используем ту же маленькую иконку

        atom = RegisterClassExW(ctypes.byref(wc))
        if not atom:
            error_code = GetLastError()
            if error_code == ERROR_CLASS_ALREADY_EXISTS: # Маловероятно с class_key, но возможно
                # print(f"Warning: Class '{self.initial_class_name}' already registered despite check (race?). Reusing.")
                # Просто повторно попытаемся получить инфо (хотя атома нет)
                self._register_class_if_needed() # Повторный вызов найдет в _window_classes
                return self.class_atom is not None # Должен найти или вернуть False
            else:
                raise ctypes.WinError(error_code, f"Failed to register window class '{self.initial_class_name}'")

        self.class_atom = atom
        # Сохраняем инфо для переиспользования
        _window_classes[class_key] = {
            'atom': atom,
            'wndproc_instance': _WndProcInstance, # Держим ссылку на колбэк
            'hicon': self._hicon,
            'hcursor': self._hcursor,
            'hbrush': self._hbrush_background,
            'is_custom_brush': self._is_custom_brush # Сохраняем флаг
        }
        # print(f"Window class '{self.initial_class_name}' registered (Atom: {atom}).")
        return True

    def create(self):
        """Создает окно Windows. Вызывается автоматически при первом доступе к hwnd или в run()."""
        if self._hwnd: return True # Окно уже создано

        if not self._register_class_if_needed():
            print("Error: Window class registration failed.", file=sys.stderr)
            return False

        # Помещаем себя в ожидание перед вызовом CreateWindowExW
        if self._self_addr not in _pending_windows:
            _pending_windows[self._self_addr] = self

        local_hwnd = CreateWindowExW(
            self.initial_ex_style,
            self.initial_class_name, # Имя класса
            self.initial_title,      # Заголовок окна
            self.initial_style,      # Стиль окна
            self.initial_x, self.initial_y,
            self.initial_width, self.initial_height,
            self.parent_hwnd,        # Родительское окно
            self.menu,               # Меню
            self._hinstance,
            ctypes.c_void_p(self._self_addr) # Передаем id(self) для связи в WndProc
        )

        # Проверка результата создания и установки self._hwnd через _UniversalWndProc
        if not local_hwnd:
            error_code = GetLastError()
            if self._self_addr in _pending_windows: # Убрать из ожидания при ошибке
                try: del _pending_windows[self._self_addr]
                except KeyError: pass
            raise ctypes.WinError(error_code, "Failed to create window (CreateWindowExW failed)")

        # _hwnd должен был быть установлен в WM_NCCREATE
        if not self._hwnd or self._hwnd != local_hwnd:
             msg = f"Window handle mismatch or not set after CreateWindowExW. API handle={local_hwnd}, internal handle={self._hwnd}"
             print(f"Error: {msg}", file=sys.stderr)
             if local_hwnd: # Попытка уничтожить "осиротевшее" окно
                 try: DestroyWindow(local_hwnd)
                 except Exception as e_dest: print(f"Error destroying orphaned window {local_hwnd}: {e_dest}")
             if self._self_addr in _pending_windows:
                try: del _pending_windows[self._self_addr]
                except KeyError: pass
             raise RuntimeError(msg) # Прерываем выполнение, это критично

        # print(f"Window HWND={self._hwnd} created successfully.")
        return True

    def run(self):
        """Запускает цикл обработки сообщений для окна."""
        if not self._hwnd:
            if not self.create():
                print("Error: Failed to run because window creation failed.", file=sys.stderr)
                return -1 # Код ошибки

        # Показываем окно перед циклом сообщений
        self.show() # Используем наш метод show
        # UpdateWindow(self._hwnd) # Обычно не нужен после ShowWindow(SW_SHOW)

        # Цикл сообщений
        msg = MSG()
        lpmsg = ctypes.byref(msg)
        exit_code = 0

        while True:
            # Использовать GetMessage для блокирующего ожидания
            ret = GetMessageW(lpmsg, None, 0, 0)

            if ret == -1: # Ошибка GetMessage
                error_code = GetLastError()
                print(f"Error in GetMessage loop: {get_last_error_message(error_code)}", file=sys.stderr)
                exit_code = -1 # Или error_code?
                break
            elif ret == 0: # WM_QUIT получено
                exit_code = msg.wParam.value if isinstance(msg.wParam, ULONG_PTR) else msg.wParam
                # print(f"WM_QUIT received. Exiting loop with code {exit_code}.")
                break
            else: # Обычное сообщение
                # TODO: Add hook for TranslateAccelerator here if needed for menus/dialogs
                TranslateMessage(lpmsg)
                DispatchMessageW(lpmsg)

        return exit_code


    def handle_message(self, hwnd, msg, wparam, lparam):
        """Центральный обработчик сообщений окна, вызывает соответствующие колбэки."""
        # Вспомогательные переменные
        res = None # Результат от колбэка

        try: # Обертка для ловли ошибок внутри конкретного обработчика колбэка
            # --- Обработка сообщений и вызов колбэков ---
            if msg == WM_CREATE:
                 if self.on_create: res = self.on_create(hwnd)
                 return res if res is not None else 0 # Успех по умолчанию
            elif msg == WM_PAINT:
                 if self.on_paint:
                     ps = PAINTSTRUCT(); hdc = BeginPaint(hwnd, ctypes.byref(ps))
                     if hdc:
                         try: self.on_paint(hwnd, hdc)
                         finally: EndPaint(hwnd, ctypes.byref(ps))
                     return 0 # Обработано
                 else: return None # Нет колбэка -> DefWindowProc
            elif msg == WM_CLOSE:
                 should_close = True
                 if self.on_close: should_close = self.on_close(hwnd)
                 if should_close: DestroyWindow(hwnd)
                 return 0 # WM_CLOSE обработан в любом случае
            elif msg == WM_DESTROY:
                 exit_code = 0
                 if self.on_destroy: res = self.on_destroy(hwnd)
                 if res is not None: exit_code = res
                 PostQuitMessage(exit_code)
                 # Здесь НЕЛЬЗЯ обнулять self._hwnd, это делает WM_NCDESTROY
                 return 0 # WM_DESTROY обработан
            elif msg == WM_MOVE:
                 if self.on_move:
                     x = LOWORD(lparam); y = HIWORD(lparam)
                     self.on_move(hwnd, x, y) # Координаты клиентской области относительно родителя или экрана
                 return 0 # Обычно не требует возврата, передача дальше не повредит
            elif msg == WM_SIZE:
                 if self.on_size:
                     w = LOWORD(lparam); h = HIWORD(lparam); st = wparam # Ширина, высота, тип (SIZE_*)
                     self.on_size(hwnd, w, h, st)
                 return 0 # Обычно обработано
            elif msg == WM_SETFOCUS:
                 if self.on_setfocus: res = self.on_setfocus(hwnd) # wparam=HWND окна, потерявшего фокус
                 return res # None по умолчанию (передать дальше)
            elif msg == WM_KILLFOCUS:
                 if self.on_killfocus: res = self.on_killfocus(hwnd) # wparam=HWND окна, получающего фокус
                 return res # None по умолчанию (передать дальше)

            # Клавиатура
            elif msg == WM_KEYDOWN or msg == WM_SYSKEYDOWN:
                 if self.on_keydown: res = self.on_keydown(hwnd, wparam, lparam) # wparam=vk_code, lparam=flags
                 return res # Колбэк решает, передавать ли дальше
            elif msg == WM_KEYUP or msg == WM_SYSKEYUP:
                 if self.on_keyup: res = self.on_keyup(hwnd, wparam, lparam)
                 return res
            elif msg == WM_CHAR or msg == WM_SYSCHAR:
                 if self.on_char: res = self.on_char(hwnd, wparam, lparam) # wparam=char_code, lparam=flags
                 return res

            # Мышь - Клиентская область
            elif msg == WM_MOUSEMOVE:
                 if self.on_mousemove:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam # Координаты, флаги клавиш (MK_*)
                     res = self.on_mousemove(hwnd, x, y, k)
                 return res # Колбэк решает
            elif msg == WM_LBUTTONDOWN:
                 if self.on_lbuttondown:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_lbuttondown(hwnd, x, y, k)
                 return res
            elif msg == WM_LBUTTONUP:
                 if self.on_lbuttonup:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_lbuttonup(hwnd, x, y, k)
                 return res
            elif msg == WM_LBUTTONDBLCLK:
                 if self.on_lbuttondblclk:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_lbuttondblclk(hwnd, x, y, k)
                 return res
            elif msg == WM_RBUTTONDOWN:
                 if self.on_rbuttondown:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_rbuttondown(hwnd, x, y, k)
                 return res
            elif msg == WM_RBUTTONUP:
                 if self.on_rbuttonup:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_rbuttonup(hwnd, x, y, k)
                 return res
            elif msg == WM_RBUTTONDBLCLK:
                 if self.on_rbuttondblclk:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_rbuttondblclk(hwnd, x, y, k)
                 return res
            elif msg == WM_MBUTTONDOWN:
                 if self.on_mbuttondown:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_mbuttondown(hwnd, x, y, k)
                 return res
            elif msg == WM_MBUTTONUP:
                 if self.on_mbuttonup:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_mbuttonup(hwnd, x, y, k)
                 return res
            elif msg == WM_MBUTTONDBLCLK:
                 if self.on_mbuttondblclk:
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                     res = self.on_mbuttondblclk(hwnd, x, y, k)
                 return res
            elif msg == WM_MOUSEWHEEL: # Вертикальное колесо
                 if self.on_mousewheel:
                     delta = GET_WHEEL_DELTA_WPARAM(wparam) # Знаковое значение прокрутки
                     keys = GET_KEYSTATE_WPARAM(wparam) # Флаги MK_*
                     x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam) # Экранные координаты!
                     # Преобразуем в клиентские
                     pt = POINT(x,y); ScreenToClient(hwnd, ctypes.byref(pt))
                     res = self.on_mousewheel(hwnd, pt.x, pt.y, delta, keys)
                 return res
            # TODO: Добавить WM_MOUSEHWHEEL для горизонтального колеса

            elif msg == WM_MOUSEHOVER:
                if self.on_mousehover:
                    x = GET_X_LPARAM(lparam); y = GET_Y_LPARAM(lparam); k = wparam
                    res = self.on_mousehover(hwnd, x, y, k)
                 # Требует TrackMouseEvent для активации
                return res
            elif msg == WM_MOUSELEAVE:
                 if self.on_mouseleave: res = self.on_mouseleave(hwnd)
                 # Требует TrackMouseEvent для активации
                 return res

            # Другие важные сообщения
            elif msg == WM_GETMINMAXINFO:
                 # TODO: Add on_getminmaxinfo callback
                 return 0 # По умолчанию обработано

            elif msg == WM_ERASEBKGND:
                 # Если есть фоновая кисть у класса (wc.hbrBackground != NULL),
                 # то DefWindowProc сама закрасит фон и вернет ненулевое значение.
                 # Если колбэк on_paint хочет сам рисовать фон (и избегать мерцания),
                 # он может установить background=None и обрабатывать WM_PAINT.
                 # Либо можно перехватить здесь и вернуть 1, если фон не нужен.
                 return None # По умолчанию - пусть DefWindowProc разбирается

        except Exception as e:
            # Ловим ошибку в колбэке пользователя, чтобы не уронить всю оконную процедуру
            print(f"Error processing message {msg} in Python callback: {e}", file=sys.stderr)
            # traceback.print_exc() # Опционально для отладки
            # В случае ошибки в колбэке, обычно лучше передать управление DefWindowProc
            # чтобы система вела себя предсказуемо, поэтому возвращаем None.

        # Если сообщение не было обработано ни одним колбэком, возвращаем None
        # _UniversalWndProc передаст управление DefWindowProcW
        return None

    # --- Методы для управления окном ---
    @property
    def hwnd(self):
        """Дескриптор окна (HWND). Окно будет создано при первом доступе, если не было создано ранее."""
        if not self._hwnd:
            # print("Accessing hwnd property, attempting to create window...")
            self.create() # Попытка создать окно
            if not self._hwnd: # Проверка после попытки создания
                 raise RuntimeError("Window could not be created upon HWND access.")
        return self._hwnd

    def set_title(self, title):
        """Устанавливает заголовок окна."""
        if not SetWindowTextW(self.hwnd, LPCWSTR(title)):
            raise ctypes.WinError(GetLastError(), f"Failed to set window title to '{title}'")

    def get_title(self):
        """Возвращает заголовок окна."""
        length = GetWindowTextLengthW(self.hwnd)
        if length == 0 and GetLastError() != 0:
            raise ctypes.WinError(GetLastError(), "Failed to get window text length")
        if length == 0: return ""

        buffer = ctypes.create_unicode_buffer(length + 1)
        if GetWindowTextW(self.hwnd, buffer, length + 1) == 0 and GetLastError() != 0:
            raise ctypes.WinError(GetLastError(), "Failed to get window text")
        return buffer.value

    def get_rect(self) -> RECT:
        """Возвращает прямоугольник окна в экранных координатах."""
        rect = RECT()
        if not GetWindowRect(self.hwnd, ctypes.byref(rect)):
             raise ctypes.WinError(GetLastError(), "Failed to get window rect")
        return rect

    def get_position(self) -> tuple[int, int]:
        """Возвращает позицию левого верхнего угла окна (x, y) в экранных координатах."""
        rect = self.get_rect()
        return (rect.left, rect.top)

    def set_position(self, x, y, redraw=True):
        """Устанавливает позицию левого верхнего угла окна в экранных координатах."""
        flags = SWP_NOZORDER | SWP_NOSIZE
        if not redraw: flags |= SWP_NOREDRAW
        if not SetWindowPos(self.hwnd, HWND(0), x, y, 0, 0, flags):
            raise ctypes.WinError(GetLastError(), f"Failed to set window position to ({x}, {y})")

    def get_size(self) -> tuple[int, int]:
        """Возвращает размер всего окна (width, height)."""
        rect = self.get_rect()
        return (rect.right - rect.left, rect.bottom - rect.top)

    def set_size(self, width, height, redraw=True):
        """Устанавливает размер всего окна (width, height)."""
        flags = SWP_NOZORDER | SWP_NOMOVE
        if not redraw: flags |= SWP_NOREDRAW
        if not SetWindowPos(self.hwnd, HWND(0), 0, 0, width, height, flags):
            raise ctypes.WinError(GetLastError(), f"Failed to set window size to ({width}x{height})")

    def get_client_rect(self) -> RECT:
        """Возвращает прямоугольник клиентской области окна (относительно левого верхнего угла клиентской области)."""
        rect = RECT()
        if not GetClientRect(self.hwnd, ctypes.byref(rect)):
             raise ctypes.WinError(GetLastError(), "Failed to get client rect")
        return rect

    def get_client_size(self) -> tuple[int, int]:
        """Возвращает размер клиентской области окна (width, height)."""
        rect = self.get_client_rect()
        return (rect.right - rect.left, rect.bottom - rect.top) # left/top всегда 0 для GetClientRect

    def center_on_screen(self):
        """Центрирует окно на экране."""
        screen_w = GetSystemMetrics(SM_CXSCREEN)
        screen_h = GetSystemMetrics(SM_CYSCREEN)
        w, h = self.get_size()
        x = (screen_w - w) // 2
        y = (screen_h - h) // 2
        self.set_position(x, y)

    def show(self, show_cmd=SW_SHOW):
        """Показывает окно с указанным флагом (SW_*)."""
        ShowWindow(self.hwnd, show_cmd)

    def hide(self):
        """Скрывает окно."""
        ShowWindow(self.hwnd, SW_HIDE)

    def minimize(self):
        """Сворачивает окно."""
        ShowWindow(self.hwnd, SW_MINIMIZE)

    def maximize(self):
        """Разворачивает окно."""
        ShowWindow(self.hwnd, SW_MAXIMIZE)

    def restore(self):
        """Восстанавливает нормальный размер и положение окна."""
        ShowWindow(self.hwnd, SW_RESTORE)

    def enable(self):
        """Делает окно активным (доступным для ввода)."""
        EnableWindow(self.hwnd, True)

    def disable(self):
        """Делает окно неактивным."""
        EnableWindow(self.hwnd, False)

    def is_enabled(self):
        """Проверяет, активно ли окно."""
        return IsWindowEnabled(self.hwnd)

    def bring_to_top(self):
        """Перемещает окно наверх Z-порядка."""
        BringWindowToTop(self.hwnd)

    def set_foreground(self):
        """Пытается сделать окно активным и вывести на передний план."""
        # Может не сработать, если у процесса нет прав
        try:
            SetForegroundWindow(self.hwnd)
        except Exception as e: # SetForegroundWindow может вызывать ошибки доступа
            print(f"Warning: SetForegroundWindow failed: {e}. Trying BringWindowToTop.", file=sys.stderr)
            try: self.bring_to_top()
            except Exception as e2: print(f"Warning: BringWindowToTop also failed: {e2}", file=sys.stderr)

    def make_topmost(self, is_topmost=True):
        """Делает окно "поверх всех окон" или обычным."""
        hwnd_insert_after = HWND_TOPMOST if is_topmost else HWND_NOTOPMOST
        if not SetWindowPos(self.hwnd, hwnd_insert_after, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE):
             raise ctypes.WinError(GetLastError(), f"Failed to set topmost status to {is_topmost}")

    def get_style(self):
        """Возвращает основные стили окна (WS_*)."""
        SetLastError(0) # Clear last error
        style = GetWindowLongPtrW(self.hwnd, GWL_STYLE)
        if style == 0:
             err = GetLastError()
             if err != 0: raise ctypes.WinError(err, "Failed to get window style")
        return style

    def set_style(self, style, redraw=True):
        """Устанавливает основные стили окна (WS_*)."""
        SetLastError(0) # Clear last error
        old_style = SetWindowLongPtrW(self.hwnd, GWL_STYLE, style)
        if old_style == 0:
            err = GetLastError()
            if err != 0: raise ctypes.WinError(err, "Failed to set window style")
        # Обновить фрейм окна, если стили изменились
        if redraw:
             SetWindowPos(self.hwnd, HWND(0), 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOOWNERZORDER)

    def get_ex_style(self):
        """Возвращает расширенные стили окна (WS_EX_*)."""
        SetLastError(0)
        style = GetWindowLongPtrW(self.hwnd, GWL_EXSTYLE)
        if style == 0:
             err = GetLastError()
             if err != 0: raise ctypes.WinError(err, "Failed to get window extended style")
        return style

    def set_ex_style(self, ex_style, redraw=True):
        """Устанавливает расширенные стили окна (WS_EX_*)."""
        SetLastError(0)
        old_style = SetWindowLongPtrW(self.hwnd, GWL_EXSTYLE, ex_style)
        if old_style == 0:
            err = GetLastError()
            if err != 0: raise ctypes.WinError(err, "Failed to set window extended style")
        if redraw:
             SetWindowPos(self.hwnd, HWND(0), 0, 0, 0, 0, SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOOWNERZORDER)

    def invalidate(self, rect=None, erase=True):
        """ Делает недействительной указанную область окна (или всю), вызывая перерисовку (WM_PAINT)."""
        rect_ptr = ctypes.byref(rect) if rect else None
        if not InvalidateRect(self.hwnd, rect_ptr, erase):
            raise ctypes.WinError(GetLastError(), "Failed to invalidate window rect")

    def close(self):
        """Инициирует закрытие окна (отправляет WM_CLOSE)."""
        if self._hwnd:
            PostMessageW(self._hwnd, WM_CLOSE, 0, 0)

    def destroy(self):
        """ Принудительно уничтожает окно, обходя WM_CLOSE."""
        if self._hwnd:
            DestroyWindow(self.hwnd) # hwnd станет None после WM_NCDESTROY

    def _clear_hwnd(self):
        """ Внутренний метод для сброса HWND после WM_NCDESTROY."""
        # print(f"HWND {self._hwnd} is being cleared.")
        self._hwnd = None
        # Удаляем кастомную кисть, если она была создана нами
        if self._is_custom_brush and self._hbrush_background:
            # print(f"Deleting custom background brush {self._hbrush_background}")
            if not DeleteObject(self._hbrush_background):
                 print(f"Warning: Failed to delete custom background brush. Error: {get_last_error_message()}", file=sys.stderr)
            self._hbrush_background = None
            self._is_custom_brush = False

    def __del__(self):
        """Деструктор объекта Python."""
        # print(f"Python object {id(self)} finalizing.")
        # Если окно все еще существует, это может быть утечкой!
        if self._hwnd:
             print(f"Warning: BaseWindow object deleted but HWND {self._hwnd} might still exist.", file=sys.stderr)
             # НЕ пытайтесь вызвать DestroyWindow отсюда, это небезопасно!
             # Но можно попытаться удалить кастомную кисть, если _clear_hwnd не вызывался
             if self._is_custom_brush and self._hbrush_background:
                  print(f"Attempting to delete potentially leaked custom brush in __del__", file=sys.stderr)
                  if not DeleteObject(self._hbrush_background): pass # Игнорируем ошибку
                  self._hbrush_background = None; self._is_custom_brush = False

        # Убираем из _pending_windows на всякий случай
        if self._self_addr in _pending_windows:
            try: del _pending_windows[self._self_addr]
            except KeyError: pass

# --- Утилиты ---
def get_screen_size() -> tuple[int, int]:
    """Возвращает размер экрана (width, height)."""
    return (GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN))

def get_cursor_pos() -> POINT:
    """Возвращает текущие координаты курсора на экране."""
    pt = POINT()
    if not GetCursorPos(ctypes.byref(pt)):
        raise ctypes.WinError(GetLastError(), "Failed to get cursor position")
    return pt

def screen_to_client(hwnd, point: POINT) -> POINT:
    """Преобразует экранные координаты в клиентские для указанного окна."""
    if not ScreenToClient(hwnd, ctypes.byref(point)):
        raise ctypes.WinError(GetLastError(), "Failed screen to client conversion")
    return point

def client_to_screen(hwnd, point: POINT) -> POINT:
    """Преобразует клиентские координаты окна в экранные."""
    if not ClientToScreen(hwnd, ctypes.byref(point)):
        raise ctypes.WinError(GetLastError(), "Failed client to screen conversion")
    return point

# Вспомогательные макросы для разбора WPARAM/LPARAM из специфичных сообщений
def GET_WHEEL_DELTA_WPARAM(wParam): return ctypes.c_short(HIWORD(wParam)).value # Delta for WM_MOUSEWHEEL
def GET_KEYSTATE_WPARAM(wParam): return LOWORD(wParam) # MK_* flags for WM_MOUSEWHEEL
