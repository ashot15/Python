# --- Глобальное временное хранилище и оконная процедура ---
# ... (_pending_windows, _UniversalWndProc, _WndProcInstance - без изменений) ...
_pending_windows = {}

# --- Оконная процедура (WndProc) ---
def _UniversalWndProc(hwnd, msg, wparam, lparam):
    """Generic Window Procedure using GWLP_USERDATA"""
    instance = None
    try: # Добавим общий try-except для отладки неожиданных ошибок в WndProc
        # При первом создании окна (WM_NCCREATE), сохраняем указатель на объект Python
        if msg == WM_NCCREATE:
            try:
                create_struct_ptr = ctypes.cast(lparam, ctypes.POINTER(CREATESTRUCTW))
                if not create_struct_ptr:
                     print("Error in WM_NCCREATE: lparam is NULL", file=sys.stderr)
                     return -1 # FALSE

                create_struct = create_struct_ptr.contents
                instance_ptr_addr = create_struct.lpCreateParams # Адрес (id) объекта Python

                if instance_ptr_addr and instance_ptr_addr in _pending_windows:
                    instance = _pending_windows[instance_ptr_addr]
                    old_value = SetWindowLongPtr(hwnd, GWLP_USERDATA, instance_ptr_addr)
                    instance._hwnd = hwnd # Устанавливаем hwnd в объекте
                    del _pending_windows[instance_ptr_addr] # Удаляем из временного хранилища
                else:
                    print(f"Error in WM_NCCREATE: Could not retrieve instance pointer addr {instance_ptr_addr} from _pending_windows", file=sys.stderr)
                    return -1 # FALSE

            except Exception as e:
                print(f"Exception in WM_NCCREATE handling: {e}", file=sys.stderr)
                if 'instance_ptr_addr' in locals() and instance_ptr_addr and instance_ptr_addr in _pending_windows:
                   try: del _pending_windows[instance_ptr_addr]
                   except KeyError: pass
                return -1 # FALSE

        # Для всех последующих сообщений получаем указатель из данных окна
        else:
            instance_ptr_addr = GetWindowLongPtr(hwnd, GWLP_USERDATA)
            if instance_ptr_addr != 0:
                try:
                    instance = ctypes.cast(instance_ptr_addr, ctypes.py_object).value
                except Exception as e:
                    print(f"Exception retrieving instance from GWLP_USERDATA for HWND {hwnd}: {e}", file=sys.stderr)
                    instance = None

        # Если объект Python найден, вызываем его обработчик сообщений
        result_from_handler = None
        if instance:
            try:
                result_from_handler = instance.handle_message(hwnd, msg, wparam, lparam)
                if result_from_handler is not None:
                    return result_from_handler
            except Exception as e:
                print(f"Error in user message handler (instance.handle_message) for msg {msg}: {e}", file=sys.stderr)
                # В случае ошибки передаем управление DefWindowProcW
                pass

        # Если экземпляр не найден ИЛИ обработчик вернул None, вызываем стандартную процедуру
        final_result = DefWindowProcW(hwnd, msg, wparam, lparam)

        # Очистка GWLP_USERDATA при уничтожении окна
        if msg == WM_NCDESTROY:
            instance_ptr_addr = GetWindowLongPtr(hwnd, GWLP_USERDATA)
            if instance_ptr_addr != 0:
                try:
                    instance_to_clear = ctypes.cast(instance_ptr_addr, ctypes.py_object).value
                    if hasattr(instance_to_clear, '_clear_hwnd'):
                        instance_to_clear._clear_hwnd()
                except Exception: pass # Игнорируем, если объект уже недоступен
                SetWindowLongPtr(hwnd, GWLP_USERDATA, 0)

        return final_result

    except Exception as e:
         print(f"FATAL ERROR in _UniversalWndProc (HWND={hwnd}, MSG={msg}): {e}", file=sys.stderr)
         try:
              return DefWindowProcW(hwnd, msg, wparam, lparam)
         except Exception as e_def:
              print(f"FATAL ERROR calling DefWindowProcW after error: {e_def}", file=sys.stderr)
              return 0

_WndProcInstance = WNDPROC(_UniversalWndProc)


# --- Класс окна ---
class BaseWindow:
    _window_classes = {}

    def __init__(self, title="Application Window", width=CW_USEDEFAULT, height=CW_USEDEFAULT, x=CW_USEDEFAULT, y=CW_USEDEFAULT, parent_hwnd=None, menu=None, style=WS_OVERLAPPEDWINDOW, ex_style=WS_EX_APPWINDOW | WS_EX_WINDOWEDGE, class_name="PyWindowClass", class_style=CS_HREDRAW | CS_VREDRAW | CS_DBLCLKS, background_brush=COLOR_WINDOW, icon_res=IDI_APPLICATION, cursor_res=IDC_ARROW, on_create=None, on_paint=None, on_destroy=None, on_close=None, on_size=None, on_lbuttondown=None, on_keydown=None):
        # ... (инициализация без изменений) ...
        self._hwnd = None
        self._hinstance = GetModuleHandleW(None) # Используем функцию с прототипом
        if not self._hinstance:
            raise ctypes.WinError(GetLastError())

        self.title = title
        self.width = width
        self.height = height
        self.x = x
        self.y = y
        self.parent_hwnd = parent_hwnd
        self.menu = menu
        self.style = style
        self.ex_style = ex_style

        # Параметры класса окна
        self.class_name = class_name # Убрал id(self)
        self.class_style = class_style
        self.background_brush_ref = background_brush # Индекс цвета или HBRUSH
        self.icon_res = icon_res
        self.cursor_res = cursor_res
        self._hicon = None
        self._hcursor = None
        self._hbrush_background = None
        self._class_registered = False # Флаг, что класс был зарегистрирован

        # Колбэки
        self.on_create = on_create
        self.on_paint = on_paint
        self.on_destroy = on_destroy
        self.on_close = on_close
        self.on_size = on_size
        self.on_lbuttondown = on_lbuttondown
        self.on_keydown = on_keydown

        self._self_addr = id(self)
        _pending_windows[self._self_addr] = self

        try:
            self._register_class_if_needed()
        except Exception as e:
            if self._self_addr in _pending_windows:
               try: del _pending_windows[self._self_addr]
               except KeyError: pass
            raise e

    # ... (_load_resource, _get_background_brush, _register_class_if_needed, create, run - без изменений) ...
    def _load_resource(self, resource_identifier, resource_type):
        """Загружает иконку или курсор."""
        if isinstance(resource_identifier, int):
            lpszName = wintypes.LPCWSTR(resource_identifier)
        elif isinstance(resource_identifier, str):
            print(f"Warning: Loading resource from file '{resource_identifier}' not implemented.", file=sys.stderr)
            # Fallback logic
            fallback_id = IDI_APPLICATION if resource_type == IMAGE_ICON else IDC_ARROW
            lpszName = wintypes.LPCWSTR(fallback_id)
            # resource_identifier = fallback_id # Keep original for error message if needed
        else:
             return None

        # Try loading as standard system resource first (NULL hInst)
        handle = LoadImageW(None, lpszName, resource_type, 0, 0, LR_DEFAULTSIZE | LR_SHARED)
        if not handle: # If not found in system resources, try loading from our module
            handle = LoadImageW(self._hinstance, lpszName, resource_type, 0, 0, LR_DEFAULTSIZE | LR_SHARED)
            if not handle:
                 # Use the original identifier in the error message
                 # print(f"Warning: Failed to load resource identifier {resource_identifier} (type {resource_type}). Error: {GetLastError()}", file=sys.stderr)
                 return None
        return handle

    def _get_background_brush(self):
         """Получает HBRUSH для фона."""
         if isinstance(self.background_brush_ref, HBRUSH) or isinstance(self.background_brush_ref, wintypes.HANDLE): # Allow raw HANDLE?
              # Check if it's a valid handle? Maybe not necessary.
              return self.background_brush_ref
         elif isinstance(self.background_brush_ref, int):
              hbrush = GetSysColorBrush(self.background_brush_ref)
              if not hbrush:
                   # print(f"Warning: GetSysColorBrush failed for index {self.background_brush_ref}. Error: {GetLastError()}. Using fallback.", file=sys.stderr)
                   hbrush = GetSysColorBrush(COLOR_WINDOW)
                   if not hbrush:
                        hbrush = GetStockObject(WHITE_BRUSH)
              return hbrush
         else:
              # print(f"Warning: Invalid background_brush_ref type: {type(self.background_brush_ref)}. Using fallback.", file=sys.stderr)
              return GetSysColorBrush(COLOR_WINDOW)

    def _register_class_if_needed(self):
        """Регистрирует класс окна."""
        if self.class_name in BaseWindow._window_classes:
            class_info = BaseWindow._window_classes[self.class_name]
            self._atom = class_info['atom']
            self._hicon = class_info.get('hicon')
            self._hcursor = class_info.get('hcursor')
            self._hbrush_background = class_info.get('hbrush')
            self._class_registered = True
            return

        wc = WNDCLASSEXW()
        wc.cbSize = ctypes.sizeof(WNDCLASSEXW)
        wc.style = self.class_style
        wc.lpfnWndProc = _WndProcInstance
        wc.cbClsExtra = 0
        wc.cbWndExtra = 0
        wc.hInstance = self._hinstance

        self._hicon = self._load_resource(self.icon_res, IMAGE_ICON)
        self._hcursor = self._load_resource(self.cursor_res, IMAGE_CURSOR)
        self._hbrush_background = self._get_background_brush()

        # Use fallbacks during assignment if load failed
        wc.hIcon = self._hicon if self._hicon else LoadImageW(None, wintypes.LPCWSTR(IDI_APPLICATION), IMAGE_ICON, 0, 0, LR_DEFAULTSIZE | LR_SHARED)
        wc.hCursor = self._hcursor if self._hcursor else LoadImageW(None, wintypes.LPCWSTR(IDC_ARROW), IMAGE_CURSOR, 0, 0, LR_DEFAULTSIZE | LR_SHARED)
        wc.hbrBackground = self._hbrush_background if self._hbrush_background else GetSysColorBrush(COLOR_WINDOW)

        wc.lpszMenuName = None
        wc.lpszClassName = self.class_name
        wc.hIconSm = self._hicon # Use same icon for small

        self._atom = RegisterClassExW(ctypes.byref(wc))
        if not self._atom:
            error_code = GetLastError()
            if error_code == ERROR_CLASS_ALREADY_EXISTS:
                 # print(f"Warning or Info: Class '{self.class_name}' already registered (Error Code {error_code}).")
                 self._class_registered = True # Assume it's there
                 # Try to fetch existing resources? Not easily possible.
                 # Just save what we intended. The first registration wins for resources.
                 BaseWindow._window_classes[self.class_name] = {
                    'atom': self._atom, # Actually 0 here, but doesn't matter
                    'wndproc_instance': _WndProcInstance,
                    'hicon': self._hicon, 'hcursor': self._hcursor, 'hbrush': self._hbrush_background
                 }
                 return
            else:
                 raise ctypes.WinError(error_code, f"Failed to register window class '{self.class_name}'")

        self._class_registered = True
        BaseWindow._window_classes[self.class_name] = {
            'atom': self._atom,
            'wndproc_instance': _WndProcInstance,
            'hicon': self._hicon, 'hcursor': self._hcursor, 'hbrush': self._hbrush_background
        }


    def create(self):
        if self._hwnd:
            return True
        if not self._class_registered:
            try: self._register_class_if_needed()
            except Exception as e:
                 print(f"Error: Failed to register class during window creation: {e}", file=sys.stderr)
                 return False
        if self._self_addr not in _pending_windows:
             _pending_windows[self._self_addr] = self

        local_hwnd = CreateWindowExW(
            self.ex_style, self.class_name, self.title, self.style,
            self.x, self.y, self.width, self.height,
            self.parent_hwnd, self.menu, self._hinstance,
            ctypes.c_void_p(self._self_addr)
        )

        if not local_hwnd:
            error_code = GetLastError()
            if self._self_addr in _pending_windows:
               try: del _pending_windows[self._self_addr]
               except KeyError: pass
            raise ctypes.WinError(error_code, "Failed to create window (CreateWindowExW failed)")

        if not self._hwnd or self._hwnd != local_hwnd:
            print(f"Error: Window handle mismatch or not set after creation. HWND from Create={local_hwnd}, self._hwnd={self._hwnd}", file=sys.stderr)
            if local_hwnd:
                DestroyWindow(local_hwnd)
            if self._self_addr in _pending_windows:
                try: del _pending_windows[self._self_addr]
                except KeyError: pass
            return False
        return True

    def run(self):
        if not self._hwnd:
            if not self.create():
                print("Failed to run: Window creation failed.", file=sys.stderr)
                return -1 # Error code

        ShowWindow(self._hwnd, SW_SHOW)
        UpdateWindow(self._hwnd)

        msg = MSG()
        lpmsg = ctypes.byref(msg)

        while True:
            ret = GetMessageW(lpmsg, None, 0, 0)
            if ret == -1:
                error_code = GetLastError()
                print(f"Error in GetMessage loop: {error_code} - {ctypes.WinError(error_code)}", file=sys.stderr)
                return error_code
            elif ret == 0:
                exit_code = 0
                # WPARAM is ULONG_PTR. Check type before accessing .value
                if isinstance(msg.wParam, ULONG_PTR):
                    exit_code = msg.wParam.value
                elif isinstance(msg.wParam, int): # Should be covered by ULONG_PTR on 64bit or ULONG on 32bit?
                    exit_code = msg.wParam
                # else default 0
                return exit_code
            else:
                TranslateMessage(lpmsg)
                DispatchMessageW(lpmsg)


    def handle_message(self, hwnd, msg, wparam, lparam):
        """Диспетчер сообщений, вызывающий колбэки."""

        if msg == WM_CREATE:
            if self.on_create: return self.on_create(hwnd)
            return 0

        elif msg == WM_PAINT:
            if self.on_paint:
                ps = PAINTSTRUCT()
                hdc = BeginPaint(hwnd, ctypes.byref(ps))
                if hdc:
                    try: self.on_paint(hwnd, hdc)
                    finally: EndPaint(hwnd, ctypes.byref(ps))
                return 0
            return None

        elif msg == WM_ERASEBKGND: return None

        elif msg == WM_CLOSE:
            should_close = True
            if self.on_close: should_close = self.on_close(hwnd)
            if should_close: DestroyWindow(hwnd)
            return 0

        elif msg == WM_DESTROY:
            exit_code = 0
            if self.on_destroy:
                res = self.on_destroy(hwnd)
                if res is not None: exit_code = res
            PostQuitMessage(exit_code)
            return 0

        elif msg == WM_SIZE:
            if self.on_size:
                width = LOWORD(lparam)    # <<< ИСПОЛЬЗУЕМ LOWORD
                height = HIWORD(lparam)   # <<< ИСПОЛЬЗУЕМ HIWORD
                resize_type = wparam      # WPARAM содержит тип изменения размера (SIZE_*)
                self.on_size(hwnd, width, height, resize_type)
            # Возврат 0 может быть важен, если дочерние окна должны сами обрабатывать WM_SIZE
            return 0

        elif msg == WM_LBUTTONDOWN:
            if self.on_lbuttondown:
                x = LOWORD(lparam)        # <<< ИСПОЛЬЗУЕМ LOWORD
                y = HIWORD(lparam)        # <<< ИСПОЛЬЗУЕМ HIWORD
                flags = wparam            # WPARAM содержит флаги состояния клавиш (MK_*)
                return self.on_lbuttondown(hwnd, x, y, flags) # Колбэк решает, возвращать ли None
            return None

        elif msg == WM_KEYDOWN:
            if self.on_keydown:
                vk_code = wparam          # WPARAM содержит виртуальный код клавиши
                # lparam содержит флаги: repeat count, scan code, extended key, context code, previous key state, transition state
                key_flags = lparam
                return self.on_keydown(hwnd, vk_code, key_flags) # Колбэк решает, возвращать ли None
            return None

        elif msg == WM_GETMINMAXINFO: return 0

        # --- Другие сообщения ---
        return None


    def close(self):
        if self._hwnd: PostMessageW(self._hwnd, WM_CLOSE, 0, 0)

    def _clear_hwnd(self): self._hwnd = None
    @property
    def hwnd(self): return self._hwnd
    def __del__(self):
        if self._self_addr in _pending_windows:
           try: del _pending_windows[self._self_addr]
           except KeyError: pass
