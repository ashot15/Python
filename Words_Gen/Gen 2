import random
import json
import os
import argparse
import re
from collections import defaultdict

# Константы для сканворда по умолчанию
DEFAULT_GRID_WIDTH = 4
DEFAULT_GRID_HEIGHT = 8
DEFAULT_MIN_WORDS = 3
DEFAULT_MAX_WORDS = 15  # Максимальное количество слов на уровень
DEFAULT_NUM_PUZZLES = 300

# Направления для размещения слов (горизонтально, вертикально и диагонально)
DIRECTIONS = [
    (1, 0),   # вправо
    (0, 1),   # вниз
    (1, 1),   # диагонально вправо-вниз
    (-1, 1),  # диагонально влево-вниз
    (-1, 0),  # влево
    (0, -1),  # вверх
    (1, -1),  # диагонально вправо-вверх
    (-1, -1)  # диагонально влево-вверх
]

def is_good_word(word):
    """Проверка качества слова (только существительные на русском)"""
    # Проверяем, что слово состоит только из русских букв
    return bool(re.match(r'^[а-яёА-ЯЁ]+$', word)) and len(word) >= 3

def load_words(filename, min_length=3, max_length=8):
    """Загрузка слов из файла с фильтрацией по длине и качеству"""
    words = []
    with open(filename, 'r', encoding='utf-8') as file:
        for line in file:
            parts = line.strip().split(maxsplit=1)
            if len(parts) > 1:
                freq, word = parts
                if min_length <= len(word) <= max_length and is_good_word(word):
                    words.append(word)
    return words

def create_empty_grid(width, height):
    """Создание пустой сетки сканворда"""
    return [['_' for _ in range(width)] for _ in range(height)]

def check_word_fit(grid, word, x, y, dx, dy):
    """Проверка, поместится ли слово в сетку, без проверки пересечений с другими словами"""
    width, height = len(grid[0]), len(grid)
    
    # Проверка, поместится ли слово в сетку
    for i in range(len(word)):
        curr_x, curr_y = x + i * dx, y + i * dy
        if not (0 <= curr_x < width and 0 <= curr_y < height):
            return False
    
    # Не проверяем пересечения, чтобы ускорить генерацию
    return True

def place_word(grid, word, x, y, dx, dy):
    """Размещение слова в сетке"""
    for i in range(len(word)):
        curr_x, curr_y = x + i * dx, y + i * dy
        grid[curr_y][curr_x] = word[i]

def get_possible_placements(grid, word, used_directions, width, height):
    """Получение всех возможных размещений слова в сетке"""
    placements = []
    
    # Создаем "тепловую карту" размещений для выбора нестандартных мест
    heatmap = [[0 for _ in range(width)] for _ in range(height)]
    
    # Чем больше букв в ячейке и вокруг нее, тем лучше для сложности поиска
    for y in range(height):
        for x in range(width):
            if grid[y][x] != '_':
                # Увеличиваем "теплоту" для клеток с буквами
                heatmap[y][x] += 3
                
                # Увеличиваем "теплоту" для соседних клеток
                for dy in [-1, 0, 1]:
                    for dx in [-1, 0, 1]:
                        ny, nx = y + dy, x + dx
                        if 0 <= ny < height and 0 <= nx < width:
                            heatmap[ny][nx] += 1
    
    # Отдаем предпочтение малоиспользуемым направлениям для усложнения поиска
    directions_preference = []
    for direction in DIRECTIONS:
        # Если направление редко использовалось, даем ему приоритет
        weight = max(1, 10 - used_directions.get(direction, 0))
        directions_preference.append((direction, weight))
    
    # Сортируем направления по предпочтительности (менее используемые в начале)
    directions_preference.sort(key=lambda x: x[1], reverse=True)
    
    # Пробуем разместить слово
    for direction, _ in directions_preference:
        dx, dy = direction
        
        # Приоритет для редких направлений и нестандартного размещения
        for y in range(height):
            for x in range(width):
                # Проверяем, подходит ли позиция
                if check_word_fit(grid, word, x, y, dx, dy):
                    # Вычисляем "сложность" размещения - чем выше тепловая карта, тем сложнее найти
                    complexity = sum(heatmap[y + i*dy][x + i*dx] for i in range(len(word)) if 0 <= y + i*dy < height and 0 <= x + i*dx < width)
                    placements.append((x, y, dx, dy, complexity))
    
    # Если есть варианты размещения, выбираем наиболее "сложные" (с высоким значением тепловой карты)
    if placements:
        # Сортируем по "сложности" (чем выше, тем лучше)
        placements.sort(key=lambda p: p[4], reverse=True)
        # Возвращаем топ-5 наиболее сложных вариантов для случайного выбора или лучший, если меньше 5
        return placements[:min(5, len(placements))]
    
    return []

def create_word_puzzle(words, width, height, max_words=DEFAULT_MAX_WORDS):
    """Создание сканворда из списка слов с максимально сложным размещением"""
    grid = create_empty_grid(width, height)
    placed_words = []
    words_info = []
    
    # Счетчик для отслеживания использования направлений
    used_directions = defaultdict(int)
    
    # Сортируем слова по длине (сначала размещаем длинные слова)
    words = sorted(words, key=len, reverse=True)
    
    # Для каждого слова ищем место в сетке
    for word in words:
        # Если достигли лимита слов для уровня, прекращаем размещение
        if len(words_info) >= max_words:
            break
            
        # Пропускаем слишком длинные слова
        if len(word) > 8:  # Максимум 8 букв для сетки 4x8
            continue
        
        # Находим возможные размещения слова
        possible_placements = get_possible_placements(grid, word, used_directions, width, height)
        
        if possible_placements:
            # Выбираем одно из самых сложных мест случайно
            placement = random.choice(possible_placements)
            x, y, dx, dy, _ = placement
            
            # Размещаем слово
            place_word(grid, word, x, y, dx, dy)
            placed_words.append(word)
            
            words_info.append({
                "word": word,
                "start": [x, y],
                "direction": [dx, dy],
                "length": len(word)
            })
            
            # Увеличиваем счетчик для этого направления
            used_directions[(dx, dy)] += 1
    
    # Заполняем оставшиеся пустые ячейки случайными буквами
    russian_letters = 'абвгдеёжзийклмнопрстуфхцчшщъыьэюя'
    for y in range(height):
        for x in range(width):
            if grid[y][x] == '_':
                # Выбираем буквы, похожие на уже существующие в сетке для усложнения
                nearby_letters = []
                for dy in [-1, 0, 1]:
                    for dx in [-1, 0, 1]:
                        ny, nx = y + dy, x + dx
                        if 0 <= ny < height and 0 <= nx < width and grid[ny][nx] != '_':
                            nearby_letters.append(grid[ny][nx])
                
                if nearby_letters and random.random() < 0.7:  # 70% шанс выбрать похожую букву
                    nearby_letters_freq = defaultdict(int)
                    for letter in nearby_letters:
                        nearby_letters_freq[letter] += 1
                    
                    # Чаще используем буквы, которые реже встречаются
                    candidates = []
                    for letter, count in nearby_letters_freq.items():
                        candidates.extend([letter] * (1 + len(nearby_letters) - count))
                    
                    if candidates:
                        grid[y][x] = random.choice(candidates)
                    else:
                        grid[y][x] = random.choice(russian_letters)
                else:
                    grid[y][x] = random.choice(russian_letters)
    
    return grid, words_info

def grid_to_str(grid):
    """Преобразование сетки в строку для вывода"""
    return '\n'.join(''.join(row) for row in grid)

def create_json_puzzle(grid, words_info, level_number):
    """Создание JSON-представления сканворда"""
    grid_str = []
    for row in grid:
        grid_str.append(''.join(row))
    
    puzzle_data = {
        "level": level_number,
        "grid": grid_str,
        "dimensions": {
            "width": len(grid[0]),
            "height": len(grid)
        },
        "words": words_info
    }
    
    return puzzle_data

def generate_puzzles(words, num_puzzles=5, width=DEFAULT_GRID_WIDTH, height=DEFAULT_GRID_HEIGHT, max_words=DEFAULT_MAX_WORDS):
    """Генерация нескольких сканвордов в один JSON-файл"""
    all_puzzles = []
    all_words = words.copy()
    
    for i in range(num_puzzles):
        if not all_words:  # Если слова закончились, прекращаем генерацию
            print(f"Слова закончились. Сгенерировано {i} сканвордов.")
            break
            
        print(f"Генерация сканворда {i+1}/{num_puzzles}...")
        grid, words_info = create_word_puzzle(all_words, width, height, max_words)
        
        if grid and words_info:
            # Создаем JSON для одного уровня
            puzzle_json = create_json_puzzle(grid, words_info, i+1)
            all_puzzles.append(puzzle_json)
            
            # Удаляем использованные слова из списка
            used_words = [info["word"] for info in words_info]
            all_words = [w for w in all_words if w not in used_words]
            
            print(f"  Размещено {len(words_info)} слов. Осталось {len(all_words)} слов.")
        else:
            print(f"  Не удалось сгенерировать сканворд {i+1}/{num_puzzles}.")
    
    # Создаем структуру для общего JSON-файла
    result = {
        "puzzles": all_puzzles,
        "total_levels": len(all_puzzles)
    }
    
    return result

def parse_args():
    """Парсинг аргументов командной строки"""
    parser = argparse.ArgumentParser(description='Генератор сканвордов')
    
    parser.add_argument('--width', type=int, default=DEFAULT_GRID_WIDTH,
                        help=f'Ширина сетки сканворда (по умолчанию: {DEFAULT_GRID_WIDTH})')
    
    parser.add_argument('--height', type=int, default=DEFAULT_GRID_HEIGHT,
                        help=f'Высота сетки сканворда (по умолчанию: {DEFAULT_GRID_HEIGHT})')
    
    parser.add_argument('--num-puzzles', type=int, default=DEFAULT_NUM_PUZZLES,
                        help=f'Количество генерируемых сканвордов (по умолчанию: {DEFAULT_NUM_PUZZLES})')
    
    parser.add_argument('--max-words', type=int, default=DEFAULT_MAX_WORDS,
                        help=f'Максимальное количество слов на уровень (по умолчанию: {DEFAULT_MAX_WORDS})')
    
    parser.add_argument('--word-file', type=str, default='analyz_v2.txt',
                        help='Файл со списком слов (по умолчанию: analyz_v2.txt)')
    
    parser.add_argument('--min-word-length', type=int, default=3,
                        help='Минимальная длина слова (по умолчанию: 3)')
    
    parser.add_argument('--max-word-length', type=int, default=8,
                        help='Максимальная длина слова (по умолчанию: 8)')
    
    parser.add_argument('--all-words', action='store_true',
                        help='Использовать все доступные слова')
    
    return parser.parse_args()

def main():
    # Получение аргументов командной строки
    args = parse_args()
    
    print(f"Загрузка слов из файла {args.word_file}...")
    
    # Загрузка слов из файла
    words = load_words(args.word_file, args.min_word_length, args.max_word_length)
    
    if not words:
        print(f"Ошибка: в файле {args.word_file} не найдено подходящих слов.")
        return
    
    print(f"Загружено {len(words)} слов подходящей длины.")
    
    # Генерация сканвордов
    print(f"Генерация {args.num_puzzles} сканвордов размером {args.width}x{args.height}...")
    puzzles_data = generate_puzzles(words, args.num_puzzles, args.width, args.height, args.max_words)
    
    # Создание директории для сохранения результатов, если она не существует
    if not os.path.exists('puzzles'):
        os.makedirs('puzzles')
    
    # Сохранение всех сканвордов в один JSON-файл
    output_file = 'puzzles/all_puzzles.json'
    print(f"Сохранение всех {len(puzzles_data['puzzles'])} сканвордов в файл {output_file}...")
    with open(output_file, 'w', encoding='utf-8') as f:
        json_str = json.dumps(puzzles_data, ensure_ascii=False, indent=2)
        f.write(json_str)
    
    print(f"Сгенерировано {len(puzzles_data['puzzles'])} сканвордов и сохранено в файл {output_file}")

if __name__ == "__main__":
    main() 
