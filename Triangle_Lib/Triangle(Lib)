    pg.display.set_caption(f"Cool Triangle Library v{__version__} Demo - Hover & Animate!")
    clock = pg.time.Clock()
    BG_COLOR = (250, 252, 255, 255) # Почти белый

    renderer = TriangleRenderer()
    my_triangles: List[Triangle] = []

    # Создаем объекты
    try:
        tri1 = create_equilateral(200, 220, 150, fill_color=(230, 60, 60, 200), border_thickness=2)
        tri1.set_position(50, 0) # Немного сдвинем
        my_triangles.append(tri1)

        tri2 = create_isosceles(500, 250, 220, 130, fill_color=(60, 210, 60, 255), border_color=(10, 60, 10, 255), border_thickness=5)
        my_triangles.append(tri2)

        tri3 = create_right_angle(800, 400, 180, 220, corner='top_right', fill_color=(60, 90, 230, 160), border_color=(10, 10, 80, 255), border_thickness=3)
        my_triangles.append(tri3)

        tri4 = Triangle( # Создаем копию первого и меняем
                vertices_orig=tri1.vertices_orig, # Берем ту же форму
                fill_color=(230, 150, 40, 255), border_thickness=1
                ).set_position(150, 450).set_scale(0.8)
        my_triangles.append(tri4)

    except TriangleError as e:
         print(f"Error creating triangles: {e}"); pg.quit(); sys.exit(1)

    # Запоминаем оригинальные стили (Больше не нужен словарь!)
    for tri in my_triangles:
        # Мы уже сохранили их в __post_init__, можем использовать их напрямую
        pass

    # Переменные для анимации и интерактивности
    anim_time = 0.0
    hovered_triangle: Optional[Triangle] = None
    HOVER_BORDER_COLOR: Color = (255, 140, 0, 255) # Яркий оранжевый
    HOVER_THICKNESS_INCREASE = 4 # На сколько увеличивать толщину при наведении

    # Основной цикл
    running = True
    while running:
        dt = clock.tick(60) / 1000.0
        anim_time += dt
        mouse_pos = pg.mouse.get_pos()

        # --- Обработка событий ---
        for event in pg.event.get():
            if event.type == pg.QUIT: running = False
            if event.type == pg.VIDEORESIZE:
                try:
                    screen = pg.display.set_mode(event.size, pg.RESIZABLE | pg.SRCALPHA)
                    SCREEN_WIDTH, SCREEN_HEIGHT = event.size
                except Exception as e:
                    print(f"Error on resize: {e}"); running=False # Выход при ошибке
            if event.type == pg.KEYDOWN:
                if event.key == pg.K_ESCAPE: running = False
                if event.key == pg.K_SPACE: # Клонируем последний добавленный треугольник
                     try:
                        cloned = my_triangles[-1].clone()
                        cloned.move(dx=20 * (len(my_triangles) % 5), dy=-20 * (len(my_triangles) % 3)) # Смещаем копию
                        my_triangles.append(cloned)
                        print(f"Cloned triangle. Total: {len(my_triangles)}")
                     except IndexError:
                          print("No triangles to clone.")
                     except Exception as e:
                          print(f"Error cloning: {e}")

        # --- Обновление состояния треугольников ---
        # Анимация (примеры)
        tri1.rotate(50 * dt)
        tri1.set_alpha_multiplier(0.5 + (math.sin(anim_time * 2.5) + 1) * 0.25) # Пульсация 0.5-1.0

