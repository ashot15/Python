        tri3.set_position(x=800 + math.cos(anim_time) * 30, y=400 + math.sin(anim_time) * 20)

        # Проверка наведения мыши (сверху вниз по порядку отрисовки)
        current_hover = None
        for tri in reversed(my_triangles):
            if tri.is_point_inside(mouse_pos):
                 current_hover = tri
                 break

        # Применяем и сбрасываем эффект наведения
        # (Плавное изменение цвета требует больше логики state management / tweening)
        for tri in my_triangles:
            is_hovered = (tri is current_hover)
            # Меняем цвет границы
            tri.set_border_color(HOVER_BORDER_COLOR if is_hovered else tri._original_border_color)
             # Меняем толщину границы
            tri.set_border_thickness(tri._original_border_thickness + HOVER_THICKNESS_INCREASE if is_hovered else tri._original_border_thickness)

        # --- Отрисовка ---
        screen.fill(BG_COLOR)
        renderer.draw_triangles(screen, my_triangles) # <-- Магия здесь
        pg.display.flip()

    # --- Выход ---
    print(f"Exiting Demo ({len(my_triangles)} triangles).")
    pg.quit()
    sys.exit()
