        t6 = create_regular_polygon_segment(750, 400, 70, num_sides=6, segment_index=2,
                                           fill_color=(40, 160, 170, 200), border_thickness=2,
                                           user_data={"id": "t6", "shape": "HexSeg", "anim": "wobble"})
        t7 = Triangle([(0,-10), (-8,8), (8,8)], # Small simple triangle
                      position=(SCREEN_WIDTH - 50, SCREEN_HEIGHT - 100), # Start near bottom right
                      fill_color=(255, 90, 160, 255), border_thickness=1,
                      user_data={"id": "t7", "shape": "Cloner", "anim": "float"})

        my_triangles.extend([t1, t2, t3, t4, t5, t6, t7])
        selected_triangle = t1 # Pre-select the first one
        print(f"Created {len(my_triangles)} triangles.")

    except (TriangleError, ValueError, TypeError) as e:
        print(f"FATAL: Error creating initial triangles: {e}", file=sys.stderr)
        pg.quit()
        sys.exit(1)
    except Exception as e: # Catch other unexpected errors during creation
        print(f"FATAL: Unexpected error during triangle creation: {e}", file=sys.stderr)
        pg.quit()
        sys.exit(1)


    # --- Demo Parameters & State ---
    anim_time = 0.0
    HOVER_C: Color = (255, 140, 0, 255)    # Hover border color: Orange
    SELECT_C: Color = (0, 150, 255, 255)   # Selected border color: Blue
    SELECT_T_INC = 2                      # Border thickness increase for select/hover (reduced slightly)
    SKEW_SPD = 50.0                       # Skew speed in degrees per second
    LERP_F = 0.20                         # Lerp factor [0.0 - 1.0] (higher = faster interpolation)


    # --- Animation Functions (with error handling) ---
    def anim_spin(t, dt):
         if not isinstance(t, Triangle): return
         try: t.rotate(75 * dt)
         except Exception as e: print(f"Anim Error (spin) on {t.user_data}: {e}")

    def anim_scale_skew(t, dt, tm):
         if not isinstance(t, Triangle): return
         try:
             sx = 1.0 + math.sin(tm * 1.8) * 0.5 # Scale X between 0.5 and 1.5
             sy = 1.0 + math.cos(tm * 2.4) * 0.4 # Scale Y between 0.6 and 1.4
             t.set_scale_xy(sx, sy)
             # Skew Y based on time, keep existing X skew
             current_skew_x = t.skew_deg[0]
             skew_y = math.sin(tm * 1.5) * 25 # Skew Y between -25 and 25 degrees
             t.set_skew_xy(current_skew_x, skew_y)
         except Exception as e: print(f"Anim Error (scale_skew) on {t.user_data}: {e}")

    def anim_pulse(t, dt, tm):
        if not isinstance(t, Triangle): return
        try:
            # Pulse alpha multiplier between ~0.6 and ~1.0
            alpha = 0.8 + math.sin(tm * 3.0) * 0.2
            t.set_alpha_multiplier(alpha)
        except Exception as e: print(f"Anim Error (pulse) on {t.user_data}: {e}")

    def anim_star(t, dt):
        if not isinstance(t, Triangle): return
        try: t.rotate(-50 * dt) # Rotate star segment
        except Exception as e: print(f"Anim Error (star) on {t.user_data}: {e}")

    def anim_wobble(t, dt, tm):
        if not isinstance(t, Triangle): return
        try:
            dx = math.sin(tm * 1.2) * 80 * dt # Horizontal wobble based on time
            t.move(dx, 0)
        except Exception as e: print(f"Anim Error (wobble) on {t.user_data}: {e}")

    def anim_float(t, dt, screen_h, reset_x_range):
        if not isinstance(t, Triangle): return
        try:
            t.move(0, -35 * dt) # Float upwards
            # If moved above the top edge (with some margin)
            if t.position[1] < -50:
                # Reset position to just below the screen at a random X position
                nx = random.uniform(*reset_x_range)
                t.set_position(nx, screen_h + 50)
        except Exception as e: print(f"Anim Error (float) on {t.user_data}: {e}")


    # --- Main Loop ---
    print("Starting main loop...")
    running = True
    frame_count = 0
    last_error_print_time = 0

    while running:
        try: # Overall loop error catcher
            # --- Timing ---
            # Get delta time, limit max step to prevent large jumps on lag
            dt = min(clock.tick(60) / 1000.0, 0.1)
            anim_time += dt
            frame_count += 1

            # --- Input ---
            mouse_pos = pg.mouse.get_pos()
            keys_pressed = pg.key.get_pressed() # Use a snapshot for the frame

            # --- Event Handling ---
            # Use try-except within event handling for robustness
            try:
                for event in pg.event.get():
                    if event.type == pg.QUIT:
                        running = False
                        print("QUIT event received.")

                    # --- Window Resizing ---
                    elif event.type == pg.VIDEORESIZE:
                        try:
                            old_w, old_h = SCREEN_WIDTH, SCREEN_HEIGHT
                            # Pygame docs recommend creating a new surface on resize
                            screen = pg.display.set_mode(event.size, WINDOW_FLAGS)
                            SCREEN_WIDTH, SCREEN_HEIGHT = screen.get_size() # Get actual size
                            print(f"Window resized from {old_w}x{old_h} to {SCREEN_WIDTH}x{SCREEN_HEIGHT}")
                            # Optional: Force a full redraw immediately
                            # screen.fill(BG_COLOR) # Clear new surface
                            # Render scene? Maybe too slow here. Let main loop handle.
                        except pg.error as e:
                             print(f"ERROR during window resize: {e}. Attempting to continue.")
                             # Optionally try to revert to old size or just hope for the best
                             # If it fails consistently, maybe set running = False
                        except Exception as e:
                            print(f"Unexpected ERROR during window resize: {e}")
                            running = False # Critical error if resize breaks

                    # --- Keyboard Input ---
                    elif event.type == pg.KEYDOWN:
                        if event.key == pg.K_ESCAPE:
                             running = False
                             print("Escape key pressed.")
                        elif event.key == pg.K_SPACE and selected_triangle:
                            # Clone Selected Triangle
                            try:
                                clone = selected_triangle.clone()
                                clone.move(random.uniform(-30, 30), random.uniform(-30, 30))
                                # Safe append: create new list or append carefully
                                my_triangles.append(clone) # Appending is generally safe outside iteration
                                selected_triangle = clone # Select the new clone
                                print(f"Cloned triangle {selected_triangle.user_data}, total: {len(my_triangles)}")
                                # pg.time.wait(5) # Optional small delay
                            except (TriangleError, ValueError, TypeError, copy.Error) as e:
                                print(f"Cloning failed for {selected_triangle.user_data}: {e}")
                            except Exception as e: print(f"Unexpected Clone Error: {e}")

                        elif event.key == pg.K_a and selected_triangle:
                            # Toggle AA for selected
                            try:
                                new_aa = not selected_triangle.antialiasing
                                selected_triangle.set_antialiasing(new_aa)
                                print(f"AA for {selected_triangle.user_data} set to {new_aa}")
                            except Exception as e: print(f"Error setting AA for {selected_triangle.user_data}: {e}")

                        elif event.key == pg.K_v:
                             # Toggle Visibility (Selected or first invisible)
                             target_vis_toggle = selected_triangle
                             if not target_vis_toggle:
                                target_vis_toggle = next((t for t in my_triangles if not t.visible), None)
                             if target_vis_toggle:
                                try:
                                     new_vis = not target_vis_toggle.visible
                                     target_vis_toggle.set_visibility(new_vis)
                                     print(f"Visibility for {target_vis_toggle.user_data} set to {new_vis}")
                                except Exception as e: print(f"Error setting visibility for {target_vis_toggle.user_data}: {e}")

                        elif event.key == pg.K_r and selected_triangle:
                             # Reset Transform for Selected
                             try:
                                selected_triangle.reset_transform()
                                print(f"Reset transform for {selected_triangle.user_data}")
                             except Exception as e: print(f"Error resetting transform for {selected_triangle.user_data}: {e}")

                        elif event.key == pg.K_DELETE and selected_triangle:
                             # Delete Selected Triangle
                             try:
                                print(f"Deleting triangle {selected_triangle.user_data}")
                                temp_selected = selected_triangle # Store ref before removal
                                my_triangles.remove(temp_selected) # Use remove on the list
                                selected_triangle = None # De-select
                                hovered_triangle = None # Clear hover as well
                                print(f"Triangle deleted, total: {len(my_triangles)}")
                             except ValueError:
                                # Should not happen if selected_triangle is in list, but handle anyway
                                print(f"Warning: Tried to delete triangle, but it was not found in list.")
                                selected_triangle = None # Ensure deselection
                             except Exception as e: print(f"Error deleting triangle: {e}")


                    # --- Mouse Input ---
                    elif event.type == pg.MOUSEBUTTONDOWN:
                         if event.button == 1: # Left Click
                             # Select Triangle / Set Pivot
                             clicked_tri = next((t for t in reversed(my_triangles) if t.visible and t.is_point_inside(event.pos)), None)

                             if clicked_tri: # Clicked on a triangle
                                  selected_triangle = clicked_tri # Select it
                                  print(f"Selected triangle: {selected_triangle.user_data}")
                                  # Set Pivot to click location
                                  try:
                                      # Pivot offset is difference between click (world) and transformed center (world)
                                      geom_center = selected_triangle.geometric_center # Local center
                                      world_pos = selected_triangle.position
                                      # Approximate transformed center for pivot calculation (less accurate but often sufficient)
                                      # TODO: Could calculate precise transformed center for accuracy? Maybe not needed for visual pivot set.
                                      # Simpler: Use transformed_pivot as ref? No, that uses the offset itself. Use geom + pos.
                                      center_world_x = geom_center[0] + world_pos[0]
                                      center_world_y = geom_center[1] + world_pos[1]

                                      # Click pos relative to untransformed geom center in world coords
                                      pivot_offset_x = event.pos[0] - center_world_x
                                      pivot_offset_y = event.pos[1] - center_world_y
                                      selected_triangle.set_pivot_offset(pivot_offset_x, pivot_offset_y)
                                      print(f"Set pivot offset for {selected_triangle.user_data} to ({pivot_offset_x:.1f}, {pivot_offset_y:.1f})")
                                  except (TriangleError, ValueError, TypeError) as e: print(f"Error setting pivot offset for {selected_triangle.user_data}: {e}")
                                  except Exception as e: print(f"Unexpected Pivot Offset Error: {e}")
                             else: # Clicked on empty space
                                  if selected_triangle: print("Deselected triangle.")
                                  selected_triangle = None # Deselect

                    elif event.type == pg.MOUSEWHEEL and selected_triangle:
                        # Scale Selected Triangle with Wheel + Modifiers
                         scale_factor = 1.1 if event.y > 0 else (1.0 / 1.1) # Adjusted for slightly slower scaling
                         shift_held = keys_pressed[pg.K_LSHIFT] or keys_pressed[pg.K_RSHIFT]
                         ctrl_held = keys_pressed[pg.K_LCTRL] or keys_pressed[pg.K_RCTRL]
                         try:
                            sx, sy = selected_triangle.scale
                            if shift_held: selected_triangle.set_scale_xy(sx * scale_factor, sy) # X only
                            elif ctrl_held: selected_triangle.set_scale_xy(sx, sy * scale_factor) # Y only
                            else: selected_triangle.rescale(scale_factor) # Uniform
                         except (TriangleError, ValueError, TypeError) as e: print(f"Error scaling {selected_triangle.user_data}: {e}")
                         except Exception as e: print(f"Unexpected Scaling Error: {e}")


            except Exception as e: # Catch errors in the event handling loop itself
                current_time = time.time()
                 # Avoid flooding console with the same error
                if current_time - last_error_print_time > 1.0:
                    print(f"ERROR during event handling: {e}", file=sys.stderr)
                    last_error_print_time = current_time


            # --- Update State (Animations, Interactions) ---
            try: # Use try-except for update logic
                 # Apply animations based on user_data or type (careful with deleted tris)
                 # This relies on t1, t2 etc variables existing and being in the list.
                 # A more robust way might iterate my_triangles and check user_data["anim"].
                tris_to_anim = {t.user_data.get("id"): t for t in my_triangles if isinstance(t.user_data, dict) and t.user_data.get("id")}

                if "t1" in tris_to_anim: anim_spin(tris_to_anim["t1"], dt)
                if "t2" in tris_to_anim: anim_scale_skew(tris_to_anim["t2"], dt, anim_time)
                if "t3" in tris_to_anim: anim_pulse(tris_to_anim["t3"], dt, anim_time)
                if "t5" in tris_to_anim: anim_star(tris_to_anim["t5"], dt)
                if "t6" in tris_to_anim: anim_wobble(tris_to_anim["t6"], dt, anim_time)
                if "t7" in tris_to_anim: anim_float(tris_to_anim["t7"], dt, SCREEN_HEIGHT, (SCREEN_WIDTH * 0.7, SCREEN_WIDTH - 30))

                # Apply skew based on keyboard input (Ctrl + Arrows)
                if selected_triangle and (keys_pressed[pg.K_LCTRL] or keys_pressed[pg.K_RCTRL]):
                    delta_sx, delta_sy = 0.0, 0.0
                    skew_amount = SKEW_SPD * dt
                    if keys_pressed[pg.K_LEFT]: delta_sx -= skew_amount
                    if keys_pressed[pg.K_RIGHT]: delta_sx += skew_amount
                    if keys_pressed[pg.K_UP]: delta_sy -= skew_amount # Skew Y 'up' visually
                    if keys_pressed[pg.K_DOWN]: delta_sy += skew_amount # Skew Y 'down' visually
                    if abs(delta_sx) > EPSILON or abs(delta_sy) > EPSILON:
                        try: selected_triangle.skew(delta_sx, delta_sy)
                        except Exception as e: print(f"Error applying keyboard skew: {e}")


                # --- Hover and Selection Feedback (Lerping Border) ---
                # Update hover state (find topmost visible triangle under mouse)
                # Needs to check against the current list *after* potential deletions
                hovered_triangle = next((t for t in reversed(my_triangles) if t.visible and t.is_point_inside(mouse_pos)), None)

                # Iterate safely over a copy if deletions/additions mid-frame were possible, but here they are handled before this block.
                for tri in my_triangles:
                    is_selected = (tri is selected_triangle)
                    is_hovered = (tri is hovered_triangle)

                    target_color = tri._original_border_color # Start with original state
                    target_thickness = float(tri._original_border_thickness)

                    if is_selected and tri.visible: # Apply selection style if visible
                        target_color = SELECT_C
                        target_thickness += SELECT_T_INC

                    if is_hovered and tri.visible: # Apply hover style (overrides select color if both)
                         target_color = HOVER_C
                         if not is_selected: # Add thickness bump only if not already selected
                             target_thickness += SELECT_T_INC

                    # Perform interpolation towards target style using Lerp
                    # Need current values *before* potentially setting them
                    current_border_c = tri.current_border_color
                    current_border_t = float(tri.border_thickness)

                    try: # Add try block for lerp operations
                         lerped_color = _lerp_color(current_border_c, target_color, LERP_F)
                         lerped_thickness = _lerp(current_border_t, target_thickness, LERP_F)

                         # Apply the lerped values using setters
                         # Setters handle internal state checks (no change -> no invalidate)
                         tri.set_border_color(lerped_color)
                         # Ensure thickness is integer for drawing functions
                         tri.set_border_thickness(int(round(lerped_thickness)))
                    except Exception as e:
                        print(f"Error lerping style for {tri.user_data}: {e}")
                        # Continue with next triangle


            except Exception as e: # Catch errors during the update logic
                current_time = time.time()
                if current_time - last_error_print_time > 1.0:
                     print(f"ERROR during state update: {e}", file=sys.stderr)
                     last_error_print_time = current_time

            # --- Drawing ---
            try: # Use try-except for drawing logic
                 # 1. Clear the screen **completely**
                 if screen: # Ensure screen exists
                     screen.fill(BG_COLOR)
                 else:
                      # This should not happen if init was successful
                      print("ERROR: Screen surface is not available for drawing!", file=sys.stderr)
                      running = False; continue # Exit loop if screen lost

                 # 2. Render all triangles
                 #   Call the renderer. It handles visibility checks and drawing logic.
                 #   The returned dirty rect list is not needed when using flip().
                 if renderer: # Ensure renderer exists
                    renderer.draw_triangles(screen, my_triangles)
                 else:
                      print("ERROR: Renderer not available!", file=sys.stderr)
                      running = False; continue

                 # 3. Draw UI / Debug Info (on top)
                 if font: # Check if font loaded successfully
                    text_y_start = 10
                    line_height = 18
                    info_col = (30, 30, 30) # Dark text color

                    # --- General Info ---
                    lines_to_render = [
                        f"Triangles: {len(my_triangles)}",
                        f"FPS: {clock.get_fps():.1f}",
                        f"Screen: {SCREEN_WIDTH}x{SCREEN_HEIGHT}",
                        f"Renderer AA: {'Available' if renderer.is_aa_available else 'N/A'}"
                    ]

                    # --- Selection Info ---
                    if selected_triangle:
                         sel_data = selected_triangle.user_data or {}
                         sel_name = sel_data.get('id', 'N/A') if isinstance(sel_data, dict) else str(sel_data)
                         lines_to_render.append("-" * 10)
                         lines_to_render.append(f"Selected: {sel_name} (Vis: {selected_triangle.visible}, AA: {selected_triangle.antialiasing})")
                         pos = selected_triangle.position
                         lines_to_render.append(f" Pos: ({pos[0]:.1f}, {pos[1]:.1f}) Rot: {selected_triangle.rotation_deg:.1f}d")
                         scl = selected_triangle.scale
                         skw = selected_triangle.skew_deg
                         lines_to_render.append(f" Scale: ({scl[0]:.2f}, {scl[1]:.2f}) Skew: ({skw[0]:.1f}, {skw[1]:.1f})")
                         pivot = selected_triangle.transformed_pivot
                         pivot_str = f"({pivot[0]:.1f},{pivot[1]:.1f})" if pivot else "N/A"
                         pivot_off = selected_triangle.pivot_offset
                         lines_to_render.append(f" Pivot Off: ({pivot_off[0]:.1f},{pivot_off[1]:.1f}) Pivot World: {pivot_str}")
                    else:
                         lines_to_render.append("-" * 10)
                         lines_to_render.append("No selection (Click to select/set pivot)")

                    # --- Controls ---
                    lines_to_render.append("-" * 10)
                    lines_to_render.append("[Esc]Quit [Spc]Clone [Del]Delete [A]AA [V]Vis [R]Reset")
                    lines_to_render.append("[Wheel/Mod]Scale [Ctrl+Arrows]Skew")

                    # --- Render Text Lines ---
                    current_y = text_y_start
                    for line in lines_to_render:
                         try:
                              text_surf = font.render(line, True, info_col)
                              screen.blit(text_surf, (10, current_y))
                              current_y += line_height
                         except pg.error as e_render: print(f"Font rendering error: {e_render}. Line: '{line}'") ; break # Stop text on error
                         except Exception as e_text: print(f"Unexpected Text Blit Error: {e_text}") ; break

                    # --- Draw Pivot Marker for Selected Triangle ---
                    if selected_triangle and selected_triangle.visible:
                         pivot_pos = selected_triangle.transformed_pivot
                         if pivot_pos and all(map(math.isfinite, pivot_pos)): # Check finite
                             try:
                                  ppx, ppy = int(round(pivot_pos[0])), int(round(pivot_pos[1]))
                                  radius = 6
                                  pivot_col = (255, 0, 255, 200) # Magenta
                                  # Draw circle and crosshairs (check if coords are on screen?)
                                  if screen.get_rect().collidepoint(ppx,ppy):
                                       pg.draw.circle(screen, pivot_col, (ppx, ppy), radius, 1)
                                       pg.draw.line(screen, pivot_col, (ppx - radius, ppy), (ppx + radius, ppy), 1)
                                       pg.draw.line(screen, pivot_col, (ppx, ppy - radius), (ppx, ppy + radius), 1)
                             except Exception as e_pivot: print(f"Error drawing pivot marker: {e_pivot}")

                 else:
                      # Fallback if font is somehow None (shouldn't happen with init checks)
                       if frame_count % 60 == 0: # Print error periodically
                           print("ERROR: Font not available for drawing UI.", file=sys.stderr)

            except Exception as e: # Catch errors during the drawing phase
                current_time = time.time()
                if current_time - last_error_print_time > 1.0:
                     print(f"ERROR during drawing: {e}", file=sys.stderr)
                     last_error_print_time = current_time


            # --- Update Display ---
            # Use pg.display.flip() to update the entire screen surface.
            # This is simpler and avoids potential issues with incomplete dirty rect lists
            # when the whole background is redrawn anyway.
            try:
                 pg.display.flip()
            except pg.error as e_flip:
                 # This might happen if display is closed or becomes invalid
                 print(f"ERROR during display flip: {e_flip}", file=sys.stderr)
                 running = False # Stop loop if display fails
                 break

        # --- End of Main Loop Try ---
        except Exception as loop_error: # Catch unexpected errors in the main loop body
            current_time = time.time()
            if current_time - last_error_print_time > 1.0:
                 print(f"FATAL ERROR in main loop: {loop_error}", file=sys.stderr)
                 last_error_print_time = current_time
            # Consider breaking the loop on major errors
            # running = False # Optionally stop the loop on any major error


    # --- Cleanup ---
    print("Exiting main loop.")
    final_tri_count = len(my_triangles) # Get count before potential quit issues
    try:
        print("Quitting Pygame...")
        pg.quit()
        print("Pygame quit successfully.")
    except Exception as e:
        print(f"Error during Pygame quit: {e}", file=sys.stderr)

    print(f"Demo finished ({final_tri_count} triangles final count).")
    sys.exit(0) # Explicit clean exit
