def main():
    """Sets up the game state and the GUI, then runs the main loop."""
    print("Starting Python Island Clicker (Single File)...")
    player_state = GameState() # GameState initialization prints its status
    root = tk.Tk()
    app = ClickerGUI(root, player_state)
    print("Running GUI main loop...")
    root.mainloop()
    print("GUI main loop finished.")

if __name__ == "__main__":
    main()
