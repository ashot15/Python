class IslandView(tk.Canvas):
    """A Canvas widget to display and handle clicks on pseudo-3D islands."""
    def __init__(self, parent, click_callback, width=400, height=300, **kwargs):
        # *** FIX HERE: Removed hardcoded bg argument from super call ***
        super().__init__(parent, width=width, height=height, **kwargs)
        self.click_callback = click_callback
        self.islands = []

        # Define island configurations
        self.island_configs = [
            {'x': 100, 'y': 150, 'size': 60, 'base_color': '#8FBC8F', 'highlight': '#98FB98', 'shadow': '#556B2F'},
            {'x': 250, 'y': 100, 'size': 45, 'base_color': '#DEB887', 'highlight': '#F5DEB3', 'shadow': '#8B4513'},
            {'x': 300, 'y': 220, 'size': 55, 'base_color': '#B0C4DE', 'highlight': '#E6E6FA', 'shadow': '#4682B4'},
            {'x': 50,  'y': 50, 'size': 40, 'base_color': '#CD853F', 'highlight': '#F4A460', 'shadow': '#8B4513'},
        ]
        self.draw_islands()
        self.bind("<Button-1>", self._on_canvas_click)
        self.bind("<Enter>", lambda e: self.config(cursor="hand2"))
        self.bind("<Leave>", lambda e: self.config(cursor=""))

    def draw_islands(self):
        self.delete("island")
        self.islands = []
        for i, config in enumerate(self.island_configs):
            island_shapes = self._draw_single_island(i, **config)
            self.islands.append({'config': config, 'shapes': island_shapes, 'index': i})

    def _draw_single_island(self, index, x, y, size, base_color, highlight, shadow, **ignored):
        shapes = {}
        tag_base = f"island_{index}"
        common_tags = ("island", tag_base)
        shadow_offset = size * 0.08
        shapes['shadow'] = self.create_oval(
            x - size / 2 + shadow_offset, y - size / 2.5 + shadow_offset,
            x + size / 2 + shadow_offset, y + size / 2.5 + shadow_offset,
            fill=shadow, outline="", tags=common_tags + ("shadow",)
        )
        shapes['base'] = self.create_oval(
            x - size / 2, y - size / 2.5,
            x + size / 2, y + size / 2.5,
            fill=base_color, outline=shadow, width=1, tags=common_tags + ("base", f"index_{index}")
        )
        highlight_size_factor = 0.75
        highlight_offset_y = -size * 0.06
        highlight_offset_x = size * 0.01
        shapes['highlight'] = self.create_oval(
            x - size / 2 * highlight_size_factor + highlight_offset_x,
            y - size / 2.5 * highlight_size_factor + highlight_offset_y,
            x + size / 2 * highlight_size_factor + highlight_offset_x,
            y + size / 2.5 * highlight_size_factor + highlight_offset_y,
            fill=highlight, outline="", tags=common_tags + ("highlight", f"index_{index}")
        )
        return shapes

    def _on_canvas_click(self, event):
        clicked_items = self.find_overlapping(event.x, event.y, event.x, event.y)
        clicked_island_index = -1
        for item_id in clicked_items:
            tags = self.gettags(item_id)
            for tag in tags:
                if tag.startswith("index_"):
                    try: clicked_island_index = int(tag.split("_")[1]); break
                    except (IndexError, ValueError): continue
            if clicked_island_index != -1: break

        if clicked_island_index != -1:
            self._flash_island(clicked_island_index)
            if self.click_callback: self.click_callback()

    def _flash_island(self, index):
        island_data = next((isl for isl in self.islands if isl['index'] == index), None)
        if not island_data: return
        highlight_id = island_data['shapes'].get('highlight')
        original_color = island_data['config'].get('highlight', 'white')
        if highlight_id:
            self.itemconfig(highlight_id, fill="white")
            self.after(100, lambda: self.itemconfig(highlight_id, fill=original_color))


