class ClickerGUI:
    """Manages the Tkinter GUI for the clicker game."""
    def __init__(self, root, game_state: GameState):
        self.root = root
        self.game_state = game_state
        self.root.title("Python Island Clicker (Single File)")
        self.root.geometry("550x650")

        self.style = ttk.Style()
        self.style.theme_use('clam')

        self.main_frame = ttk.Frame(self.root, padding="10")
        self.main_frame.grid(row=0, column=0, sticky="nsew")
        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)

        # Top Row: Resources and Lands
        self.info_frame = ttk.Frame(self.main_frame)
        self.info_frame.grid(row=0, column=0, sticky="new", padx=5, pady=5)
        self.info_frame.columnconfigure(0, weight=1)
        self.info_frame.columnconfigure(1, weight=1)

        self.resource_frame = ttk.LabelFrame(self.info_frame, text="Resources", padding="10")
        self.resource_frame.grid(row=0, column=0, sticky="nsew", padx=(0, 5))
        self.resource_labels = {}
        self._create_resource_display()

        self.land_frame = ttk.LabelFrame(self.info_frame, text="Unlocked Lands", padding="10")
        self.land_frame.grid(row=0, column=1, sticky="nsew", padx=(5, 0))
        self.land_list_label = ttk.Label(self.land_frame, text="", justify=tk.LEFT, wraplength=200)
        self.land_list_label.pack(anchor=tk.W)
        self.info_frame.rowconfigure(0, weight=0) # Don't let info row expand vertically too much
        self.land_frame.rowconfigure(0, weight=1) # Allow text label inside to manage height

        # Middle Row: Island Canvas
        self.island_canvas_frame = ttk.Frame(self.main_frame, borderwidth=1, relief=tk.SUNKEN)
        self.island_canvas_frame.grid(row=1, column=0, sticky="nsew", pady=10)
        self.main_frame.rowconfigure(1, weight=1) # Canvas row expands
        self.main_frame.columnconfigure(0, weight=1)

        # Use the corrected bg argument passing here
        self.island_view = IslandView(self.island_canvas_frame, self._island_click_action, bg="#ADD8E6")
        self.island_view.pack(expand=True, fill=tk.BOTH)

        # Bottom Row: Buttons and Status
        self.bottom_frame = ttk.Frame(self.main_frame)
        self.bottom_frame.grid(row=2, column=0, sticky="sew", pady=(5, 0))
        self.bottom_frame.columnconfigure(0, weight=1)
        self.bottom_frame.columnconfigure(1, weight=1)

        self.unlock_button = ttk.Button(self.bottom_frame, text="Unlock New Lands...", command=self._open_unlock_window)
        self.unlock_button.grid(row=0, column=0, sticky="ew", padx=5, pady=5)

        self.quit_button = ttk.Button(self.bottom_frame, text="Quit", command=self.root.quit)
        self.quit_button.grid(row=0, column=1, sticky="ew", padx=5, pady=5)

        self.status_var = tk.StringVar()
        self.status_bar = ttk.Label(self.bottom_frame, textvariable=self.status_var, relief=tk.SUNKEN, anchor=tk.W)
        self.status_bar.grid(row=1, column=0, columnspan=2, sticky="sew", pady=(5, 0))
        self.status_var.set("Welcome! Click an island to start.")

        self.update_display()

    def _create_resource_display(self):
        ttk.Label(self.resource_frame, text=f"{resource_manager.get_display_name('clicks')}:").grid(row=0, column=0, sticky=tk.W, padx=2)
        self.resource_labels['clicks'] = ttk.Label(self.resource_frame, text="0", width=12, anchor=tk.E)
        self.resource_labels['clicks'].grid(row=0, column=1, sticky=tk.E, padx=2)

        row_index = 1
        for name, props in resource_manager.definitions.items():
            if name != 'clicks':
                display_name = props['display_name']
                name_label = ttk.Label(self.resource_frame, text=f"{display_name}:")
                name_label.grid(row=row_index, column=0, sticky=tk.W, padx=2)
                name_label.grid_remove()
                value_label = ttk.Label(self.resource_frame, text="0", width=12, anchor=tk.E)
                value_label.grid(row=row_index, column=1, sticky=tk.E, padx=2)
                value_label.grid_remove()
                self.resource_labels[name] = {'name': name_label, 'value': value_label}
                row_index += 1
        self.resource_frame.columnconfigure(1, weight=1)

    def update_display(self):
        self.resource_labels['clicks'].config(text=f"{self.game_state.clicks:,}")
        for name, labels in self.resource_labels.items():
            if name == 'clicks': continue
            amount = self.game_state.resources.get(name, 0)
            label_widget = labels.get('value')
            name_widget = labels.get('name')
            if label_widget and name_widget:
                if amount > 0:
                    label_widget.config(text=f"{amount:,}")
                    name_widget.grid()
                    label_widget.grid()
                else:
                    name_widget.grid_remove()
                    label_widget.grid_remove()

        unlocked_names = [land_manager.get_display_name(lname) for lname in sorted(list(self.game_state.unlocked_lands))]
        self.land_list_label.config(text="- " + "\n- ".join(unlocked_names) if unlocked_names else "(None)")
        self.root.update_idletasks()

    def _island_click_action(self):
        modifiers = self.game_state.get_current_modifiers()
        gained_resources = resource_manager.generate_resources_on_click(modifiers)

        gained_summary = []
        if not gained_resources: # Should not happen if BASE_CLICK_REWARD > 0
             self.status_var.set("Click registered. No resources gained.")
        else:
            for resource_name, amount in gained_resources.items():
                self.game_state.add_resource(resource_name, amount)
                if amount > 0: # Only report positive gains
                     display_name = resource_manager.get_display_name(resource_name)
                     gained_summary.append(f"+{amount} {display_name}")

            if gained_summary:
                self.status_var.set("Gained: " + ", ".join(gained_summary))
            elif 'clicks' in gained_resources and gained_resources['clicks'] > 0 : # Handle case where only clicks gained (and were > 0)
                self.status_var.set(f"Gained: +{gained_resources['clicks']} {resource_manager.get_display_name('clicks')}")
            else: # Handle case where clicks were 0 or negative, and nothing else gained
                 self.status_var.set("Click registered.")


        self.update_display()

    def _open_unlock_window(self):
        available_lands = self.game_state.get_available_unlocks()
        if not available_lands:
            messagebox.showinfo("Unlock Lands", "No new lands available to unlock.", parent=self.root)
            return

        unlock_window = tk.Toplevel(self.root)
        unlock_window.title("Unlock New Lands")
        unlock_window.transient(self.root)
        unlock_window.grab_set()
        unlock_window.resizable(False, False)

        popup_frame = ttk.Frame(unlock_window, padding="15")
        popup_frame.pack(expand=True, fill=tk.BOTH)
        ttk.Label(popup_frame, text="Select a land to unlock:", font=('Helvetica', 11, 'bold')).pack(pady=(0, 10))

        for land_name in available_lands:
            display_name = land_manager.get_display_name(land_name)
            cost_str = land_manager.get_unlock_cost_str(land_name)
            can_afford = land_manager.can_unlock(land_name, self.game_state.resources)

            land_frame = ttk.Frame(popup_frame)
            land_frame.pack(fill=tk.X, pady=3)
            info_text = f"{display_name}\nCost: {cost_str}"
            ttk.Label(land_frame, text=info_text, justify=tk.LEFT).pack(side=tk.LEFT, expand=True, fill=tk.X, padx=(0,10))
            unlock_btn = ttk.Button(land_frame, text="Unlock", command=lambda name=land_name: self._unlock_land_action(name, unlock_window))
            if not can_afford: unlock_btn.config(state=tk.DISABLED)
            unlock_btn.pack(side=tk.RIGHT)

        ttk.Separator(popup_frame, orient=tk.HORIZONTAL).pack(fill=tk.X, pady=10)
        ttk.Button(popup_frame, text="Close", command=unlock_window.destroy).pack()

        # Center popup
        unlock_window.update_idletasks()
        root_x, root_y = self.root.winfo_x(), self.root.winfo_y()
        root_w, root_h = self.root.winfo_width(), self.root.winfo_height()
        popup_w, popup_h = unlock_window.winfo_width(), unlock_window.winfo_height()
        x = root_x + (root_w // 2) - (popup_w // 2)
        y = root_y + (root_h // 2) - (popup_h // 2)
        unlock_window.geometry(f"+{x}+{y}")

    def _unlock_land_action(self, land_name, unlock_window):
        display_name = land_manager.get_display_name(land_name)
        if land_manager.can_unlock(land_name, self.game_state.resources):
            success = self.game_state.unlock_land(land_name) # Handles spending
            if success:
                self.status_var.set(f"Successfully unlocked {display_name}!")
                messagebox.showinfo("Success", f"You have unlocked the {display_name}!", parent=unlock_window)
                self.update_display()
                unlock_window.destroy()
            else: # Should not happen often if can_unlock passed
                self.status_var.set(f"Failed to unlock {display_name} (Error).")
                messagebox.showerror("Error", f"An error occurred trying to unlock {display_name}.", parent=unlock_window)
        else: # Should be blocked by button state, but check again
            self.status_var.set(f"Cannot afford to unlock {display_name}.")
            messagebox.showwarning("Cannot Afford", f"You don't have enough resources for {display_name}.", parent=unlock_window)


