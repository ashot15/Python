# --- Game Settings ---
BASE_CLICK_REWARD = 1  # Clicks gained per basic click

# --- Resource Definitions ---
RESOURCE_DEFINITIONS = {
    'clicks': {'display_name': 'Clicks', 'is_rare': False, 'base_drop_chance': 1.0},
    'gem': {'display_name': 'Gem', 'is_rare': True, 'base_drop_chance': 0.05}, # 5% base chance
    'shard': {'display_name': 'Magic Shard', 'is_rare': True, 'base_drop_chance': 0.02}, # 2% base chance
    'essence': {'display_name': 'Pure Essence', 'is_rare': True, 'base_drop_chance': 0.0} # Starts unobtainable
}

# --- Land Definitions ---
LAND_DEFINITIONS = {
    'home': {
        'display_name': 'Home Base',
        'cost': {}, # Starting land, no cost
        'modifier': {} # No initial modifiers
    },
    'crystal_caves': {
        'display_name': 'Crystal Caves',
        'cost': {'clicks': 100, 'gem': 5},
        'modifier': {'gem': 0.10} # Increases Gem chance to 10%
    },
    'enchanted_forest': {
        'display_name': 'Enchanted Forest',
        'cost': {'clicks': 500, 'shard': 3},
        'modifier': {'shard': 0.08, 'gem': 0.12} # Increases Shard chance, slightly increases Gem too
    },
    'astral_plane': {
        'display_name': 'Astral Plane',
        'cost': {'clicks': 2000, 'gem': 20, 'shard': 10},
        'modifier': {'essence': 0.01, 'shard': 0.10} # Unlocks Essence chance, boosts Shard further
    }
}

# --- Initial State ---
INITIAL_CLICKS = 0
STARTING_LAND = 'home'


# ==============================================================================
# Resources Logic (formerly resources.py)
# ==============================================================================

class Resources:
    """Handles definition and generation of resources."""
    def __init__(self, definitions):
        self.definitions = definitions
        self.rare_resources = {name: props for name, props in definitions.items() if props.get('is_rare', False)}
        print(f"Initializing Resources. Rare resources found: {list(self.rare_resources.keys())}")

    def get_display_name(self, resource_name):
        return self.definitions.get(resource_name, {}).get('display_name', resource_name)

    def get_base_drop_chance(self, resource_name):
        return self.definitions.get(resource_name, {}).get('base_drop_chance', 0.0)

    def generate_resources_on_click(self, current_land_modifiers):
        # print(f"Generating resources with modifiers: {current_land_modifiers}") # Optional Debug
        gained = {'clicks': BASE_CLICK_REWARD}

        for name, props in self.rare_resources.items():
            current_chance = self.get_base_drop_chance(name)
            if name in current_land_modifiers:
                current_chance = current_land_modifiers[name]
                # print(f"Applying modifier for {name}: new chance = {current_chance:.2f}") # Optional Debug

            if random.random() < current_chance:
                gained[name] = gained.get(name, 0) + 1
                # print(f"Success! Generated 1 {self.get_display_name(name)} (Chance: {current_chance:.2f})") # Optional Debug

        # Ensure clicks are always in the gained dictionary, even if 0 reward initially
        if 'clicks' not in gained:
            gained['clicks'] = 0
        elif gained['clicks'] <= 0 and BASE_CLICK_REWARD <= 0: # Handle edge case of 0 base reward
             gained.pop('clicks', None) # Remove if zero and base is zero


        return gained

# --- Resource Manager Instance ---
resource_manager = Resources(RESOURCE_DEFINITIONS)


# ==============================================================================
# Lands Logic (formerly lands.py)
# ==============================================================================

class Lands:
    """Handles definition and unlocking of lands."""
    def __init__(self, definitions):
        self.definitions = definitions
        print("Initializing Lands.")

    def get_display_name(self, land_name):
        return self.definitions.get(land_name, {}).get('display_name', land_name)

    def get_unlock_cost(self, land_name):
        return self.definitions.get(land_name, {}).get('cost', {})

    def get_resource_modifier(self, land_name):
        return self.definitions.get(land_name, {}).get('modifier', {})

    def get_combined_modifiers(self, unlocked_land_names):
        combined_mods = {}
        for res_name, props in resource_manager.definitions.items():
             if props.get('is_rare'):
                 combined_mods[res_name] = props.get('base_drop_chance', 0.0)

        # print(f"Calculating combined modifiers for unlocked lands: {unlocked_land_names}") # Optional Debug
        for land_name in unlocked_land_names:
             land_mods = self.get_resource_modifier(land_name)
             if land_mods:
                 # print(f"Applying modifiers from {self.get_display_name(land_name)}: {land_mods}") # Optional Debug
                 combined_mods.update(land_mods)

        # print(f"Final combined modifiers: {combined_mods}") # Optional Debug
        return combined_mods

    def can_unlock(self, land_name, player_resources):
        cost = self.get_unlock_cost(land_name)
        if not cost:
            return False
        for resource, required_amount in cost.items():
            if player_resources.get(resource, 0) < required_amount:
                # print(f"Cannot unlock {self.get_display_name(land_name)}. Need {required_amount} {resource_manager.get_display_name(resource)}, have {player_resources.get(resource, 0)}.") # Optional Debug
                return False
        return True

    def get_unlock_cost_str(self, land_name):
        cost = self.get_unlock_cost(land_name)
        if not cost: return "N/A"
        return ", ".join([f"{amount} {resource_manager.get_display_name(resource)}" for resource, amount in cost.items()])

# --- Land Manager Instance ---
land_manager = Lands(LAND_DEFINITIONS)


# ==============================================================================
# Game State Logic (formerly game_state.py)
# ==============================================================================

class GameState:
    """Stores the current state of the game for the player."""
    def __init__(self):
        self.clicks = INITIAL_CLICKS
        self.resources = {name: 0 for name in RESOURCE_DEFINITIONS}
        self.resources['clicks'] = self.clicks
        self.unlocked_lands = {STARTING_LAND}
        print(f"GameState initialized. Starting land: {STARTING_LAND}. Initial resources: {self.resources}")

    def add_resource(self, resource_name, amount=1):
        if amount <= 0: return # Don't add zero or negative
        if resource_name in self.resources:
            self.resources[resource_name] += amount
            if resource_name == 'clicks':
                self.clicks = self.resources['clicks']
            # print(f"Added {amount} {resource_manager.get_display_name(resource_name)}. Total: {self.resources[resource_name]}") # Optional Debug
        else:
            print(f"Warning: Tried to add unknown resource '{resource_name}'")

    def spend_resources(self, cost_dict):
        can_afford = all(self.resources.get(res, 0) >= amount for res, amount in cost_dict.items())
        if not can_afford:
            # print("Spending failed: Not enough resources.") # Optional Debug
            return False

        for resource, amount in cost_dict.items():
            self.resources[resource] -= amount
            if resource == 'clicks':
                self.clicks = self.resources['clicks']
            # print(f"Spent {amount} {resource_manager.get_display_name(resource)}. Remaining: {self.resources[resource]}") # Optional Debug

        # print("Spending successful.") # Optional Debug
        return True

    def unlock_land(self, land_name):
        if land_name in land_manager.definitions and land_name not in self.unlocked_lands:
            cost = land_manager.get_unlock_cost(land_name)
            # print(f"Attempting to unlock {land_manager.get_display_name(land_name)} for cost: {cost}") # Optional Debug
            if self.spend_resources(cost):
                self.unlocked_lands.add(land_name)
                print(f"Successfully unlocked {land_manager.get_display_name(land_name)}!")
                return True
            else:
                # print(f"Failed to unlock {land_manager.get_display_name(land_name)} due to insufficient resources.") # Optional Debug
                return False
        elif land_name in self.unlocked_lands:
             # print(f"Land '{land_manager.get_display_name(land_name)}' is already unlocked.") # Optional Debug
             return False
        else:
            print(f"Error: Land '{land_name}' not defined.")
            return False

    def get_current_modifiers(self):
        return land_manager.get_combined_modifiers(self.unlocked_lands)

    def get_available_unlocks(self):
        return [name for name in land_manager.definitions if name not in self.unlocked_lands and land_manager.get_unlock_cost(name)]


